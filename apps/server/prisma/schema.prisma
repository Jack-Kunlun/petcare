// apps/server/prisma/schema.prisma

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// 服务者评分资格状态。
enum ProviderRatingEligibilityStatus {
  insufficient_sample
  eligible
  warning
  suspended
}

/// 服务者再培训状态。
enum ProviderRetrainingStatus {
  not_required
  required
  completed
}

// ============================================
// 用户相关
// ============================================

model User {
  id              String   @id @default(uuid())
  openid          String?  @unique
  phone           String?  @unique
  username        String?  @unique
  passwordHash    String?  @map("password_hash")
  nickname        String
  avatar          String?
  avatarObjectKey String?  @map("avatar_object_key")
  sessionVersion  Int      @default(0) @map("session_version")
  userType        String   @default("pet_owner") @map("user_type") // pet_owner / provider
  status          String   @default("active") // active / inactive / banned
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  profile                           UserProfile?
  provider                          Provider?
  pets                              Pet[]
  ordersAsOwner                     Order[]                            @relation("OrderOwner")
  ordersAsProvider                  Order[]                            @relation("OrderProvider")
  orderIntents                      OrderIntent[]
  posts                             Post[]
  communityMediaAssets              CommunityMediaAsset[]              @relation("CommunityMediaAssetOwner")
  communityPostLikes                CommunityPostLike[]                @relation("CommunityPostLikeUser")
  communityPostReports              CommunityPostReport[]              @relation("CommunityPostReportReporter")
  communityPostModerationEvents     CommunityPostModerationEvent[]     @relation("CommunityPostModerationOperator")
  classroomArticles                 ClassroomArticle[]
  favorites                         Favorite[]
  notifications                     Notification[]
  reviews                           Review[]
  comments                          Comment[]
  follows                           Follow[]                           @relation("Follower")
  followings                        Follow[]                           @relation("Following")
  creditScore                       CreditScore?
  creditRecords                     CreditRecord[]
  roles                             UserRole[]
  /// 用户作为投诉方发起的投诉。
  complaints                        Complaint[]                        @relation("Complainant")
  /// 用户作为被投诉方参与的投诉。
  complaintsAsRespondent            Complaint[]                        @relation("Respondent")
  /// 管理员当前受理的投诉。
  assignedComplaints                Complaint[]                        @relation("ComplaintAssignee")
  /// 用户提交的投诉陈述记录。
  complaintStatements               ComplaintStatement[]               @relation("ComplaintStatementAuthor")
  /// 管理员作出的纠纷裁决。
  disputeDecisions                  DisputeDecision[]                  @relation("DisputeDecisionAdmin")
  /// 管理员发起的投诉分配记录。
  complaintAssignmentsMade          ComplaintAssignment[]              @relation("ComplaintAssignmentAssigner")
  /// 管理员接收的投诉分配记录。
  complaintAssignmentsReceived      ComplaintAssignment[]              @relation("ComplaintAssignmentAssignee")
  /// 用户触发的投诉事件。
  complaintEvents                   ComplaintEvent[]                   @relation("ComplaintEventActor")
  /// 用户因投诉裁决产生的退款或结算内部账务记录。
  disputeMoneyRecords               DisputeMoneyRecord[]
  certificationApplications         ProviderCertificationApplication[] @relation("CertificationApplicant")
  reviewedCertificationApplications ProviderCertificationApplication[] @relation("CertificationReviewer")
  /// 该用户创建的系统配置版本。
  systemConfigVersionsCreated       SystemConfigVersion[]              @relation("SystemConfigVersionCreatedBy")
  /// 该用户最后更新的系统配置版本。
  systemConfigVersionsUpdated       SystemConfigVersion[]              @relation("SystemConfigVersionUpdatedBy")
  /// 该用户发布的系统配置版本。
  systemConfigVersionsPublished     SystemConfigVersion[]              @relation("SystemConfigVersionPublishedBy")
  /// 该用户执行的系统配置审计事件。
  systemConfigAuditEvents           SystemConfigAuditEvent[]           @relation("SystemConfigAuditOperator")
  websiteContentVersionsCreated     WebsiteContentVersion[]            @relation("WebsiteContentVersionCreatedBy")
  websiteContentVersionsPublished   WebsiteContentVersion[]            @relation("WebsiteContentVersionPublishedBy")
  websiteMediaAssetsCreated         WebsiteMediaAsset[]                @relation("WebsiteMediaAssetCreatedBy")
  websitePreviewTokensCreated       WebsitePreviewToken[]              @relation("WebsitePreviewTokenCreatedBy")
  websiteContentAuditLogs           WebsiteContentAuditLog[]           @relation("WebsiteContentAuditOperator")

  @@index([phone])
  @@index([userType])
  @@map("users")
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  realName  String?  @map("real_name")
  gender    String? // male / female
  age       Int?
  address   String?
  bio       String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Provider {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  idCardVerified  Boolean  @default(false) @map("id_card_verified")
  wechatScore     Int?     @map("wechat_score")
  trainingPassed  Boolean  @default(false) @map("training_passed")
  certifiedSitter Boolean  @default(false) @map("certified_sitter")
  rejectRate      Float    @default(0.0) @map("reject_rate") // 拒绝率
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratingEligibility ProviderRatingEligibility?
  adminTodos        AdminTodo[]

  @@index([certifiedSitter])
  @@map("providers")
}

model ProviderCertificationApplication {
  id             String    @id @default(uuid())
  applicantId    String    @map("applicant_id")
  realNameMasked String    @map("real_name_masked")
  idCardMasked   String    @map("id_card_masked")
  idCardFrontUrl String    @map("id_card_front_url")
  idCardBackUrl  String    @map("id_card_back_url")
  wechatScore    Int?      @map("wechat_score")
  trainingPassed Boolean   @default(false) @map("training_passed")
  status         String    @default("pending")
  rejectReason   String?   @map("reject_reason")
  reviewedById   String?   @map("reviewed_by_id")
  reviewedAt     DateTime? @map("reviewed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  applicant  User  @relation("CertificationApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("CertificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([applicantId, createdAt])
  @@map("provider_certification_applications")
}

// ============================================
// 宠物相关
// ============================================

model Pet {
  id         String   @id @default(uuid())
  ownerId    String   @map("owner_id")
  name       String
  breed      String
  age        Float
  weight     Float?
  gender     String // male / female
  sterilized Boolean  @default(false)
  habits     String? // 特殊习性
  allergies  String? // 过敏史
  photos     String[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  owner  User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  orders Order[]
  posts  Post[]

  @@index([ownerId])
  @@map("pets")
}

// ============================================
// 订单相关
// ============================================

model Order {
  id                 String    @id @default(uuid())
  orderType          String    @map("order_type") // reward / platform
  serviceType        String    @map("service_type") // feeding / walking / playing
  ownerId            String    @map("owner_id")
  providerId         String?   @map("provider_id")
  petId              String    @map("pet_id")
  serviceTime        DateTime  @map("service_time")
  address            String
  /// 订单金额，单位为分。
  amount             Int
  status             String    @default("pending_confirm") // pending_confirm / confirmed / in_progress / disputed / completed / cancelled
  remark             String?
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  /// 订单创建时冻结的 SOP 配置版本唯一标识。
  sopConfigVersionId String?   @map("sop_config_version_id")
  /// 订单创建时冻结的费用配置版本唯一标识。
  feeConfigVersionId String?   @map("fee_config_version_id")

  owner               User                 @relation("OrderOwner", fields: [ownerId], references: [id])
  provider            User?                @relation("OrderProvider", fields: [providerId], references: [id])
  pet                 Pet                  @relation(fields: [petId], references: [id])
  reward              OrderReward?
  platform            OrderPlatform?
  intents             OrderIntent[]
  sops                OrderSop[]
  review              Review?
  /// 订单关联的全部投诉，开放投诉唯一性由事务保证。
  complaints          Complaint[]
  /// 订单因投诉裁决产生的退款或结算内部账务记录。
  disputeMoneyRecords DisputeMoneyRecord[]
  /// 订单创建时冻结的 SOP 配置版本。
  sopConfigVersion    SystemConfigVersion? @relation("OrderSopConfigVersion", fields: [sopConfigVersionId], references: [id], onDelete: Restrict)
  /// 订单创建时冻结的费用配置版本。
  feeConfigVersion    SystemConfigVersion? @relation("OrderFeeConfigVersion", fields: [feeConfigVersionId], references: [id], onDelete: Restrict)
  /// 订单创建时冻结的费用计算快照。
  feeSnapshot         OrderFeeSnapshot?

  @@index([ownerId])
  @@index([providerId])
  @@index([status])
  @@index([orderType])
  @@index([sopConfigVersionId])
  @@index([feeConfigVersionId])
  @@map("orders")
}

model OrderFeeSnapshot {
  /// 费用快照唯一标识。
  id                        String   @id @default(uuid())
  /// 快照所属订单唯一标识。
  orderId                   String   @unique @map("order_id")
  /// 费用计算使用的发布配置版本唯一标识。
  feeConfigVersionId        String   @map("fee_config_version_id")
  /// 费用计算使用的订单输入金额，单位为分。
  inputAmountCents          Int      @map("input_amount_cents")
  /// 平台佣金比例，使用整数万分比。
  platformCommissionBps     Int      @map("platform_commission_bps")
  /// 按订单金额计算的平台佣金，单位为分。
  platformCommissionCents   Int      @map("platform_commission_cents")
  /// 悬赏订单固定服务费，单位为分。
  rewardServiceFeeCents     Int      @map("reward_service_fee_cents")
  /// 提现手续费比例，使用整数万分比。
  withdrawalFeeBps          Int      @map("withdrawal_fee_bps")
  /// 最低提现手续费，单位为分。
  minimumWithdrawalFeeCents Int      @map("minimum_withdrawal_fee_cents")
  /// 扣除平台订单费用后的服务者结算金额，单位为分。
  providerSettlementCents   Int      @map("provider_settlement_cents")
  /// 费用快照创建时间。
  createdAt                 DateTime @default(now()) @map("created_at")

  /// 快照所属订单。
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// 费用计算使用的发布配置版本。
  feeConfigVersion SystemConfigVersion @relation("OrderFeeSnapshotConfigVersion", fields: [feeConfigVersionId], references: [id], onDelete: Restrict)

  @@index([feeConfigVersionId])
  @@map("order_fee_snapshots")
}

model OrderReward {
  id            String   @id @default(uuid())
  orderId       String   @unique @map("order_id")
  /// 悬赏金额，单位为分。
  rewardAmount  Int      @map("reward_amount")
  /// 可接受价格下限，单位为分。
  priceRangeMin Int      @map("price_range_min")
  /// 可接受价格上限，单位为分。
  priceRangeMax Int      @map("price_range_max")
  expireTime    DateTime @map("expire_time")
  createdAt     DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_rewards")
}

model OrderPlatform {
  id                 String   @id @default(uuid())
  orderId            String   @unique @map("order_id")
  /// 平台定价金额，单位为分。
  platformPrice      Int      @map("platform_price")
  assignedProviderId String?  @map("assigned_provider_id")
  createdAt          DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_platforms")
}

model OrderIntent {
  id           String   @id @default(uuid())
  orderId      String   @map("order_id")
  providerId   String   @map("provider_id")
  intentStatus String   @default("pending") @map("intent_status") // pending / confirmed / rejected
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider User  @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([orderId, providerId])
  @@index([orderId])
  @@index([providerId])
  @@map("order_intents")
}

model OrderSop {
  id                      String    @id @default(uuid())
  orderId                 String    @map("order_id")
  stepNumber              Int       @map("step_number") // 1-5
  stepName                String    @map("step_name") // 进门消毒 / 拍照打卡 / 执行服务 / 清理现场 / 离开拍照
  /// 下单时冻结的步骤执行说明。
  instruction             String
  /// 下单时冻结的步骤预计时长，单位为分钟。
  expectedDurationMinutes Int       @map("expected_duration_minutes")
  /// 下单时冻结的步骤最少照片数量。
  minimumPhotoCount       Int       @map("minimum_photo_count")
  /// 下单时冻结的步骤视频必传要求。
  videoRequired           Boolean   @default(false) @map("video_required")
  /// 下单时冻结并序列化保存的违规处理指引。
  violationGuidance       String    @map("violation_guidance")
  photos                  String[]
  videos                  String[]
  completedAt             DateTime? @map("completed_at")
  createdAt               DateTime  @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_sops")
}

// ============================================
// 系统配置版本
// ============================================

model SystemConfigVersion {
  /// 配置版本唯一标识。
  id              String    @id @default(uuid())
  /// 配置领域稳定键，取 sop、rating_threshold 或 fee。
  configKey       String    @map("config_key")
  /// 配置生命周期状态，取 draft、published 或 superseded。
  status          String
  /// 同一配置领域内单调递增的发布版本号。
  businessVersion Int       @map("business_version")
  /// 草稿乐观并发修订号。
  revision        Int       @default(1)
  /// 活跃草稿固定写 active，发布版本保持为空。
  draftSlot       String?   @map("draft_slot")
  /// 创建该配置版本的管理员唯一标识。
  createdById     String    @map("created_by_id")
  /// 最后更新该配置版本的管理员唯一标识。
  updatedById     String    @map("updated_by_id")
  /// 发布该配置版本的管理员唯一标识。
  publishedById   String?   @map("published_by_id")
  /// 配置版本发布时间。
  publishedAt     DateTime? @map("published_at")
  /// 恢复或复制配置时引用的来源版本唯一标识。
  sourceVersionId String?   @map("source_version_id")
  /// 防止重复创建或发布配置版本的业务幂等键。
  idempotencyKey  String?   @unique @map("idempotency_key")
  /// 本配置版本的业务变更摘要。
  changeSummary   String    @map("change_summary")
  /// 配置版本创建时间。
  createdAt       DateTime  @default(now()) @map("created_at")
  /// 配置版本最后更新时间。
  updatedAt       DateTime  @updatedAt @map("updated_at")

  /// 该版本复制或恢复时引用的来源版本。
  sourceVersion         SystemConfigVersion?        @relation("SystemConfigVersionSource", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  /// 从该版本复制或恢复生成的后续版本。
  derivedVersions       SystemConfigVersion[]       @relation("SystemConfigVersionSource")
  /// 指向该发布版本的当前版本指针。
  publishedPointer      SystemConfigPointer?
  /// 该 SOP 版本冻结的步骤。
  sopSteps              SopConfigStep[]
  /// 该 SOP 版本冻结的违规规则。
  sopViolationRules     SopViolationRule[]
  /// 该评分版本冻结的阈值配置。
  ratingThresholdConfig RatingThresholdConfig?
  /// 该费用版本冻结的费率配置。
  feeConfig             FeeConfig?
  /// 该版本关联的审计事件。
  auditEvents           SystemConfigAuditEvent[]
  /// 创建该配置版本的管理员。
  createdBy             User                        @relation("SystemConfigVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  /// 最后更新该配置版本的管理员。
  updatedBy             User                        @relation("SystemConfigVersionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  /// 发布该配置版本的管理员；草稿阶段为空。
  publishedBy           User?                       @relation("SystemConfigVersionPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  /// 引用该 SOP 版本的订单。
  sopOrders             Order[]                     @relation("OrderSopConfigVersion")
  /// 引用该费用版本的订单。
  feeOrders             Order[]                     @relation("OrderFeeConfigVersion")
  /// 使用该费用版本完成计算的订单费用快照。
  feeSnapshots          OrderFeeSnapshot[]          @relation("OrderFeeSnapshotConfigVersion")
  /// 当前按该评分配置完成评估的服务者资格状态。
  providerEligibilities ProviderRatingEligibility[] @relation("ProviderRatingEligibilityConfigVersion")

  @@unique([configKey, businessVersion])
  @@unique([configKey, draftSlot])
  @@index([configKey, status])
  @@index([sourceVersionId])
  @@index([createdById])
  @@index([updatedById])
  @@index([publishedById])
  @@map("system_config_versions")
}

model SystemConfigPointer {
  /// 配置领域稳定键，同时保证每个领域只有一个当前版本指针。
  configKey          String   @id @map("config_key")
  /// 当前已发布配置版本唯一标识。
  publishedVersionId String   @unique @map("published_version_id")
  /// 指针创建时间。
  createdAt          DateTime @default(now()) @map("created_at")
  /// 指针最后更新时间。
  updatedAt          DateTime @updatedAt @map("updated_at")

  /// 当前生效的已发布配置版本。
  publishedVersion SystemConfigVersion @relation(fields: [publishedVersionId], references: [id], onDelete: Restrict)

  @@map("system_config_pointers")
}

model SopConfigStep {
  /// SOP 配置步骤唯一标识。
  id                      String  @id @default(uuid())
  /// 所属配置版本唯一标识。
  configVersionId         String  @map("config_version_id")
  /// 适用服务类型，取 feeding、walking 或 playing。
  serviceType             String  @map("service_type")
  /// 服务类型内从一开始的步骤序号。
  stepNumber              Int     @map("step_number")
  /// 步骤展示名称。
  stepName                String  @map("step_name")
  /// 步骤执行说明。
  instruction             String
  /// 步骤预计时长，单位为分钟。
  expectedDurationMinutes Int     @map("expected_duration_minutes")
  /// 步骤最少照片数量。
  minimumPhotoCount       Int     @map("minimum_photo_count")
  /// 步骤是否必须上传视频。
  videoRequired           Boolean @default(false) @map("video_required")

  /// 步骤所属的 SOP 配置版本。
  configVersion SystemConfigVersion @relation(fields: [configVersionId], references: [id], onDelete: Cascade)

  @@unique([configVersionId, serviceType, stepNumber])
  @@index([configVersionId])
  @@map("sop_config_steps")
}

model SopViolationRule {
  /// SOP 违规规则唯一标识。
  id                     String  @id @default(uuid())
  /// 所属配置版本唯一标识。
  configVersionId        String  @map("config_version_id")
  /// 违规严重程度，取 minor、moderate 或 severe。
  severity               String
  /// 违规条件和处理说明。
  description            String
  /// 服务费扣减比例，使用整数万分比；未配置扣减时为空。
  serviceFeeDeductionBps Int?    @map("service_fee_deduction_bps")
  /// 评分扣减值，使用整数百分值。
  ratingDeductionScore   Int     @default(0) @map("rating_deduction_score")
  /// 暂停接单天数，不暂停时为零。
  suspensionDays         Int     @default(0) @map("suspension_days")
  /// 是否要求重新培训。
  retrainingRequired     Boolean @default(false) @map("retraining_required")
  /// 规则展示顺序。
  sortOrder              Int     @map("sort_order")

  /// 规则所属的 SOP 配置版本。
  configVersion SystemConfigVersion @relation(fields: [configVersionId], references: [id], onDelete: Cascade)

  @@unique([configVersionId, severity])
  @@index([configVersionId, sortOrder])
  @@map("sop_violation_rules")
}

model RatingThresholdConfig {
  /// 评分阈值配置唯一标识。
  id                    String @id @default(uuid())
  /// 所属配置版本唯一标识，同时保证领域数据一对一。
  configVersionId       String @unique @map("config_version_id")
  /// 评分统计窗口，表示最近已评价订单数量。
  evaluationWindow      Int    @map("evaluation_window")
  /// 阈值生效所需最小评价样本数。
  minimumSampleSize     Int    @map("minimum_sample_size")
  /// 触发预警的评分阈值，使用整数百分值。
  warningScore          Int    @map("warning_score")
  /// 触发暂停接单的评分阈值，使用整数百分值。
  suspensionScore       Int    @map("suspension_score")
  /// 恢复接单前必须满足的再培训要求。
  retrainingRequirement String @map("retraining_requirement")

  /// 配置所属的评分阈值版本。
  configVersion SystemConfigVersion @relation(fields: [configVersionId], references: [id], onDelete: Cascade)

  @@map("rating_threshold_configs")
}

model FeeConfig {
  /// 费率配置唯一标识。
  id                        String @id @default(uuid())
  /// 所属配置版本唯一标识，同时保证领域数据一对一。
  configVersionId           String @unique @map("config_version_id")
  /// 平台佣金比例，使用整数万分比。
  platformCommissionBps     Int    @map("platform_commission_bps")
  /// 悬赏订单固定服务费，单位为分。
  rewardServiceFeeCents     Int    @map("reward_service_fee_cents")
  /// 提现手续费比例，使用整数万分比。
  withdrawalFeeBps          Int    @map("withdrawal_fee_bps")
  /// 最低提现手续费，单位为分。
  minimumWithdrawalFeeCents Int    @map("minimum_withdrawal_fee_cents")

  /// 配置所属的费用版本。
  configVersion SystemConfigVersion @relation(fields: [configVersionId], references: [id], onDelete: Cascade)

  @@map("fee_configs")
}

model SystemConfigAuditEvent {
  /// 配置审计事件唯一标识。
  id              String   @id @default(uuid())
  /// 事件所属配置领域稳定键。
  configKey       String   @map("config_key")
  /// 事件关联的配置版本唯一标识。
  configVersionId String?  @map("config_version_id")
  /// 执行配置操作的管理员唯一标识。
  operatorId      String   @map("operator_id")
  /// 配置操作类型。
  action          String
  /// 防止审计事件重复写入的业务幂等键。
  idempotencyKey  String   @map("idempotency_key")
  /// 本次配置操作的业务变更摘要。
  changeSummary   String   @map("change_summary")
  /// 审计事件创建时间。
  createdAt       DateTime @default(now()) @map("created_at")

  /// 事件关联的配置版本。
  configVersion SystemConfigVersion? @relation(fields: [configVersionId], references: [id], onDelete: SetNull)
  /// 执行该配置操作的管理员。
  operator      User                 @relation("SystemConfigAuditOperator", fields: [operatorId], references: [id], onDelete: Restrict)

  @@unique([configKey, idempotencyKey])
  @@index([configKey, createdAt])
  @@index([configVersionId])
  @@index([operatorId])
  @@map("system_config_audit_events")
}

// ============================================
// 评价与纠纷
// ============================================

// ============================================
// 官网内容版本
// ============================================

model WebsiteContent {
  id                    String   @id @default(uuid())
  contentKey            String   @unique @map("content_key")
  contentType           String   @map("content_type")
  currentDraftVersionId String?  @unique @map("current_draft_version_id")
  publishedVersionId    String?  @unique @map("published_version_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  versions            WebsiteContentVersion[]  @relation("WebsiteContentVersions")
  currentDraftVersion WebsiteContentVersion?   @relation("WebsiteCurrentDraftVersion", fields: [currentDraftVersionId], references: [id], onDelete: Restrict)
  publishedVersion    WebsiteContentVersion?   @relation("WebsitePublishedVersion", fields: [publishedVersionId], references: [id], onDelete: Restrict)
  previewTokens       WebsitePreviewToken[]
  auditLogs           WebsiteContentAuditLog[]

  @@index([contentType])
  @@map("website_contents")
}

model WebsiteContentVersion {
  id               String    @id @default(uuid())
  websiteContentId String    @map("website_content_id")
  status           String
  revision         Int
  businessVersion  Int?      @map("business_version")
  seo              Json
  sourceVersionId  String?   @map("source_version_id")
  idempotencyKey   String?   @unique @map("idempotency_key")
  changeSummary    String    @map("change_summary")
  createdById      String    @map("created_by_id")
  publishedById    String?   @map("published_by_id")
  publishedAt      DateTime? @map("published_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  websiteContent  WebsiteContent           @relation("WebsiteContentVersions", fields: [websiteContentId], references: [id], onDelete: Cascade)
  currentDraftFor WebsiteContent?          @relation("WebsiteCurrentDraftVersion")
  publishedFor    WebsiteContent?          @relation("WebsitePublishedVersion")
  sourceVersion   WebsiteContentVersion?   @relation("WebsiteContentVersionSource", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  derivedVersions WebsiteContentVersion[]  @relation("WebsiteContentVersionSource")
  sections        WebsiteContentSection[]
  previewTokens   WebsitePreviewToken[]
  auditLogs       WebsiteContentAuditLog[]
  createdBy       User                     @relation("WebsiteContentVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy     User?                    @relation("WebsiteContentVersionPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([websiteContentId, revision])
  @@unique([websiteContentId, businessVersion])
  @@index([websiteContentId, status])
  @@index([sourceVersionId])
  @@index([createdById])
  @@index([publishedById])
  @@map("website_content_versions")
}

model WebsiteContentSection {
  id            String   @id @default(uuid())
  versionId     String   @map("version_id")
  sectionKey    String   @map("section_key")
  sectionType   String   @map("section_type")
  sortOrder     Int      @map("sort_order")
  isEnabled     Boolean  @default(true) @map("is_enabled")
  schemaVersion Int      @default(1) @map("schema_version")
  content       Json
  settings      Json
  createdAt     DateTime @default(now()) @map("created_at")

  version WebsiteContentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, sectionKey])
  @@unique([versionId, sortOrder])
  @@index([versionId, sortOrder])
  @@map("website_content_sections")
}

model WebsiteMediaAsset {
  id           String    @id @default(uuid())
  storageKey   String    @unique @map("storage_key")
  originalName String    @map("original_name")
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  width        Int
  height       Int
  checksum     String
  status       String    @default("active")
  createdById  String    @map("created_by_id")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  createdBy User                     @relation("WebsiteMediaAssetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  auditLogs WebsiteContentAuditLog[]

  @@index([status, createdAt])
  @@index([checksum])
  @@index([createdById])
  @@map("website_media_assets")
}

model WebsitePreviewToken {
  id               String    @id @default(uuid())
  tokenHash        String    @unique @map("token_hash")
  websiteContentId String    @map("website_content_id")
  contentVersionId String    @map("content_version_id")
  revision         Int
  createdById      String    @map("created_by_id")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime? @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  websiteContent WebsiteContent        @relation(fields: [websiteContentId], references: [id], onDelete: Cascade)
  contentVersion WebsiteContentVersion @relation(fields: [contentVersionId], references: [id], onDelete: Cascade)
  createdBy      User                  @relation("WebsitePreviewTokenCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([websiteContentId, contentVersionId])
  @@index([expiresAt, revokedAt])
  @@index([createdById])
  @@map("website_preview_tokens")
}

model WebsiteContentAuditLog {
  id               String   @id @default(uuid())
  websiteContentId String?  @map("website_content_id")
  contentVersionId String?  @map("content_version_id")
  mediaAssetId     String?  @map("media_asset_id")
  operatorId       String   @map("operator_id")
  action           String
  targetType       String   @map("target_type")
  targetId         String?  @map("target_id")
  revision         Int?
  businessVersion  Int?     @map("business_version")
  requestId        String   @map("request_id")
  result           Json?
  createdAt        DateTime @default(now()) @map("created_at")

  websiteContent WebsiteContent?        @relation(fields: [websiteContentId], references: [id], onDelete: SetNull)
  contentVersion WebsiteContentVersion? @relation(fields: [contentVersionId], references: [id], onDelete: SetNull)
  mediaAsset     WebsiteMediaAsset?     @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  operator       User                   @relation("WebsiteContentAuditOperator", fields: [operatorId], references: [id], onDelete: Restrict)

  @@index([websiteContentId, createdAt])
  @@index([contentVersionId])
  @@index([mediaAssetId])
  @@index([operatorId, createdAt])
  @@index([requestId])
  @@map("website_content_audit_logs")
}

model Review {
  id                 String   @id @default(uuid())
  orderId            String   @unique @map("order_id")
  reviewerId         String   @map("reviewer_id")
  attitudeRating     Int      @map("attitude_rating") // 1-5
  professionalRating Int      @map("professional_rating") // 1-5
  punctualityRating  Int      @map("punctuality_rating") // 1-5
  sopExecutionRating Int      @map("sop_execution_rating") // 1-5
  overallRating      Int      @map("overall_rating") // 1-5
  content            String?
  photos             String[]
  createdAt          DateTime @default(now()) @map("created_at")

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewer User  @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([reviewerId])
  @@map("reviews")
}

/// 服务者当前评分资格及恢复接单所需状态。
model ProviderRatingEligibility {
  /// 资格状态唯一标识。
  id                     String                          @id @default(uuid())
  /// 服务者档案唯一标识，同时保证每位服务者只有一份当前资格状态。
  providerId             String                          @unique @map("provider_id")
  /// 最近一次评估使用的发布评分配置版本。
  ratingConfigVersionId  String                          @map("rating_config_version_id")
  /// 最近一次评估输入的唯一摘要，用于避免重复执行副作用。
  evaluationKey          String                          @unique @map("evaluation_key")
  /// 当前资格状态，取 insufficient_sample、eligible、warning 或 suspended。
  status                 ProviderRatingEligibilityStatus @default(insufficient_sample)
  /// 最近评价的整数百分制平均分；没有评价时为空。
  averageScore           Int?                            @map("average_score")
  /// 最近一次评估实际使用的评价样本数。
  sampleSize             Int                             @default(0) @map("sample_size")
  /// 暂停后恢复接单前必须满足的再培训要求。
  retrainingRequirement  String?                         @map("retraining_requirement")
  /// 再培训状态，取 not_required、required 或 completed。
  retrainingStatus       ProviderRetrainingStatus        @default(not_required) @map("retraining_status")
  /// 当前告警或暂停周期使用的副作用去重键；恢复后清空。
  actionDeduplicationKey String?                         @map("action_deduplication_key")
  /// 最近一次进入暂停接单状态的时间。
  suspendedAt            DateTime?                       @map("suspended_at")
  /// 最近一次完成评分资格评估的时间。
  evaluatedAt            DateTime                        @default(now()) @map("evaluated_at")

  /// 资格状态所属服务者档案。
  provider      Provider            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  /// 最近一次评估使用的发布评分配置版本。
  configVersion SystemConfigVersion @relation("ProviderRatingEligibilityConfigVersion", fields: [ratingConfigVersionId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([ratingConfigVersionId])
  @@map("provider_rating_eligibilities")
}

/// 需要管理员处理的评分资格待办。
model AdminTodo {
  /// 待办唯一标识。
  id               String   @id @default(uuid())
  /// 待办关联的服务者档案唯一标识。
  providerId       String   @map("provider_id")
  /// 待办业务类型。
  type             String
  /// 管理员待办标题。
  title            String
  /// 管理员待办完整说明。
  content          String
  /// 待办状态，取 pending 或 completed。
  status           String   @default("pending")
  /// 业务唯一去重键，防止重复评估创建相同待办。
  deduplicationKey String   @unique @map("deduplication_key")
  /// 待办创建时间。
  createdAt        DateTime @default(now()) @map("created_at")
  /// 待办最后更新时间。
  updatedAt        DateTime @updatedAt @map("updated_at")

  /// 待办关联的服务者档案。
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([providerId])
  @@map("admin_todos")
}

model Complaint {
  /// 投诉唯一标识。
  id               String    @id @default(uuid())
  /// 供运营人员识别与检索的稳定唯一案件编号。
  caseNumber       String    @unique @map("case_number")
  /// 被投诉订单唯一标识。
  orderId          String    @map("order_id")
  /// 投诉方用户唯一标识。
  complainantId    String    @map("complainant_id")
  /// 被投诉方用户唯一标识。
  respondentId     String    @map("respondent_id")
  /// 当前受理管理员唯一标识，未认领时为空。
  assignedAdminId  String?   @map("assigned_admin_id")
  /// 投诉业务类型。
  complaintType    String    @map("complaint_type")
  /// 投诉方期望的处理方案。
  expectedSolution String?   @map("expected_solution")
  /// 投诉状态，取 pending_response、unassigned、processing_initial、initial_decided、processing_final、closed 或 withdrawn。
  status           String    @default("pending_response")
  /// 初审后二次申诉的截止时间。
  appealDeadlineAt DateTime? @map("appeal_deadline_at")
  /// 乐观并发控制版本号。
  version          Int       @default(1)
  /// 投诉创建时间。
  createdAt        DateTime  @default(now()) @map("created_at")
  /// 投诉最后更新时间。
  updatedAt        DateTime  @updatedAt @map("updated_at")
  /// 投诉关闭时间，未关闭时为空。
  closedAt         DateTime? @map("closed_at")

  /// 投诉所属订单。
  order          Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// 发起投诉的用户。
  complainant    User                   @relation("Complainant", fields: [complainantId], references: [id], onDelete: Cascade)
  /// 被投诉的用户。
  respondent     User                   @relation("Respondent", fields: [respondentId], references: [id], onDelete: Cascade)
  /// 当前受理管理员。
  assignedAdmin  User?                  @relation("ComplaintAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  /// 投诉各阶段的陈述材料。
  statements     ComplaintStatement[]
  /// 投诉的初审与终审裁决。
  decisions      DisputeDecision[]
  /// 投诉的管理员分配历史。
  assignments    ComplaintAssignment[]
  /// 投诉状态流转与操作事件。
  events         ComplaintEvent[]
  /// 裁决产生的内部执行任务。
  executionTasks DisputeExecutionTask[]
  /// 投诉裁决产生的退款或结算内部账务记录。
  moneyRecords   DisputeMoneyRecord[]

  @@index([status, assignedAdminId])
  @@index([orderId, status])
  @@index([appealDeadlineAt])
  @@map("complaints")
}

model ComplaintStatement {
  /// 陈述记录唯一标识。
  id           String   @id @default(uuid())
  /// 所属投诉唯一标识。
  complaintId  String   @map("complaint_id")
  /// 陈述阶段，用于区分首次材料、首次回应和二次申诉。
  stage        String
  /// 陈述提交人唯一标识。
  authorId     String   @map("author_id")
  /// 陈述正文。
  statement    String
  /// 陈述附带的证据地址列表。
  evidenceUrls String[] @map("evidence_urls")
  /// 陈述提交时间。
  createdAt    DateTime @default(now()) @map("created_at")

  /// 陈述所属投诉。
  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  /// 提交陈述的用户。
  author    User      @relation("ComplaintStatementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([complaintId, stage, authorId])
  @@map("complaint_statements")
}

model DisputeDecision {
  /// 裁决唯一标识。
  id                     String   @id @default(uuid())
  /// 所属投诉唯一标识。
  complaintId            String   @map("complaint_id")
  /// 作出裁决的管理员唯一标识。
  decisionAdminId        String   @map("decision_admin_id")
  /// 裁决层级，取 initial 或 final。
  level                  String
  /// 责任划分结果。
  liability              String
  /// 裁决理由。
  reason                 String
  /// 退还投诉方的金额，单位为分。
  refundAmount           Int      @map("refund_amount")
  /// 结算给服务方的金额，单位为分。
  settlementAmount       Int      @map("settlement_amount")
  /// 投诉方信用分调整值。
  complainantCreditDelta Int      @map("complainant_credit_delta")
  /// 被投诉方信用分调整值。
  respondentCreditDelta  Int      @map("respondent_credit_delta")
  /// 裁决创建时间。
  createdAt              DateTime @default(now()) @map("created_at")

  /// 裁决所属投诉。
  complaint      Complaint              @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  /// 作出裁决的管理员。
  decisionAdmin  User                   @relation("DisputeDecisionAdmin", fields: [decisionAdminId], references: [id], onDelete: Cascade)
  /// 裁决产生的内部执行任务。
  executionTasks DisputeExecutionTask[]

  @@unique([complaintId, level])
  @@map("dispute_decisions")
}

model ComplaintAssignment {
  /// 分配记录唯一标识。
  id                String   @id @default(uuid())
  /// 所属投诉唯一标识。
  complaintId       String   @map("complaint_id")
  /// 接收投诉的管理员唯一标识。
  assigneeAdminId   String   @map("assignee_admin_id")
  /// 发起分配的管理员唯一标识。
  assignedByAdminId String   @map("assigned_by_admin_id")
  /// 分配发生时间。
  createdAt         DateTime @default(now()) @map("created_at")

  /// 分配记录所属投诉。
  complaint       Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  /// 接收投诉的管理员。
  assigneeAdmin   User      @relation("ComplaintAssignmentAssignee", fields: [assigneeAdminId], references: [id], onDelete: Cascade)
  /// 发起分配的管理员。
  assignedByAdmin User      @relation("ComplaintAssignmentAssigner", fields: [assignedByAdminId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt])
  @@map("complaint_assignments")
}

model ComplaintEvent {
  /// 事件唯一标识。
  id          String   @id @default(uuid())
  /// 所属投诉唯一标识。
  complaintId String   @map("complaint_id")
  /// 操作人唯一标识，系统事件时为空。
  actorId     String?  @map("actor_id")
  /// 触发事件的业务动作。
  action      String
  /// 动作发生前的共享投诉状态。
  fromStatus  String?  @map("from_status")
  /// 动作完成后的共享投诉状态。
  toStatus    String?  @map("to_status")
  /// 事件扩展数据，使用 JSON 字符串格式。
  payload     String?
  /// 事件发生时间。
  createdAt   DateTime @default(now()) @map("created_at")

  /// 事件所属投诉。
  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  /// 触发事件的用户，系统事件时为空。
  actor     User?     @relation("ComplaintEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([complaintId, createdAt])
  @@map("complaint_events")
}

model DisputeExecutionTask {
  /// 执行任务唯一标识。
  id             String    @id @default(uuid())
  /// 所属投诉唯一标识。
  complaintId    String    @map("complaint_id")
  /// 来源裁决唯一标识。
  decisionId     String    @map("decision_id")
  /// 来源裁决层级，取 initial 或 final。
  decisionLevel  String    @map("decision_level")
  /// 内部副作用类型，如退款、结算或信用分调整。
  taskType       String    @map("task_type")
  /// 执行任务参数，使用 JSON 字符串格式。
  payload        String?
  /// 执行状态，取 pending、processing、succeeded、failed 或 superseded。
  status         String    @default("pending")
  /// 最近一次执行失败原因。
  failureReason  String?   @map("failure_reason")
  /// 已执行的重试次数。
  retryCount     Int       @default(0) @map("retry_count")
  /// 防止重复执行同一内部副作用的幂等键。
  idempotencyKey String    @unique @map("idempotency_key")
  /// 任务成功完成时间。
  completedAt    DateTime? @map("completed_at")
  /// 任务创建时间。
  createdAt      DateTime  @default(now()) @map("created_at")
  /// 任务最后更新时间。
  updatedAt      DateTime  @updatedAt @map("updated_at")

  /// 任务所属投诉。
  complaint   Complaint           @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  /// 任务来源裁决。
  decision    DisputeDecision     @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  /// 该执行任务产生的唯一内部账务记录；非金额任务为空。
  moneyRecord DisputeMoneyRecord?

  @@index([complaintId, status])
  @@map("dispute_execution_tasks")
}

model DisputeMoneyRecord {
  /// 内部账务记录唯一标识。
  id                String   @id @default(uuid())
  /// 收款或退款用户唯一标识。
  userId            String   @map("user_id")
  /// 关联订单唯一标识。
  orderId           String   @map("order_id")
  /// 关联投诉唯一标识。
  complaintId       String   @map("complaint_id")
  /// 产生该记录的纠纷执行任务唯一标识。
  executionTaskId   String   @unique @map("execution_task_id")
  /// 账务类型，取 refund 或 settlement。
  type              String
  /// 账务金额，单位为分；零金额仍保留审计记录。
  amount            Int
  /// 与执行任务幂等键一致的唯一业务引用。
  businessReference String   @unique @map("business_reference")
  /// 账务记录创建时间。
  createdAt         DateTime @default(now()) @map("created_at")

  /// 账务记录对应用户。
  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// 账务记录对应订单。
  order         Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// 账务记录对应投诉。
  complaint     Complaint            @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  /// 账务记录来源执行任务。
  executionTask DisputeExecutionTask @relation(fields: [executionTaskId], references: [id], onDelete: Restrict)

  @@index([complaintId, type, createdAt])
  @@index([userId, createdAt])
  @@index([orderId, createdAt])
  @@map("dispute_money_records")
}

// ============================================
// 社区相关
// ============================================

model Post {
  id               String   @id @default(uuid())
  authorId         String   @map("author_id")
  content          String
  mediaUrls        String[] @map("media_urls")
  tags             String[]
  petId            String?  @map("pet_id")
  likesCount       Int      @default(0) @map("likes_count")
  commentsCount    Int      @default(0) @map("comments_count")
  sharesCount      Int      @default(0) @map("shares_count")
  /// pending / published / rejected / offline / deleted
  status           String   @default("pending")
  /// 审核驳回或下架原因；只通过受控作者和管理员响应返回。
  moderationReason String?  @map("moderation_reason")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  author           User                           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  pet              Pet?                           @relation(fields: [petId], references: [id])
  favorites        Favorite[]
  comments         Comment[]
  likes            CommunityPostLike[]
  mediaAssets      CommunityMediaAsset[]
  reports          CommunityPostReport[]
  moderationEvents CommunityPostModerationEvent[]

  @@index([authorId])
  @@index([createdAt])
  @@map("posts")
}

model CommunityMediaAsset {
  id           String   @id @default(uuid())
  ownerId      String   @map("owner_id")
  postId       String?  @map("post_id")
  storageKey   String   @unique @map("storage_key")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  width        Int
  height       Int
  checksum     String
  /// active / discarded
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  owner User  @relation("CommunityMediaAssetOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  post  Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([ownerId, status, createdAt])
  @@index([postId])
  @@index([checksum])
  @@map("community_media_assets")
}

model CommunityPostModerationEvent {
  id             String   @id @default(uuid())
  postId         String   @map("post_id")
  operatorId     String   @map("operator_id")
  action         String
  previousStatus String   @map("previous_status")
  nextStatus     String   @map("next_status")
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")

  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  operator User @relation("CommunityPostModerationOperator", fields: [operatorId], references: [id], onDelete: Restrict)

  @@index([postId, createdAt])
  @@index([operatorId, createdAt])
  @@map("community_post_moderation_events")
}

model CommunityPostReport {
  id          String    @id @default(uuid())
  postId      String    @map("post_id")
  reporterId  String    @map("reporter_id")
  reason      String
  description String?
  /// pending / resolved
  status      String    @default("pending")
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter User @relation("CommunityPostReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)

  @@unique([postId, reporterId])
  @@index([postId, status, createdAt])
  @@index([reporterId, createdAt])
  @@map("community_post_reports")
}

model CommunityPostLike {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("CommunityPostLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@map("community_post_likes")
}

// ============================================
// 内容管理
// ============================================

model ClassroomArticle {
  id          String    @id @default(uuid())
  category    String?
  title       String
  summary     String
  coverUrl    String?   @map("cover_url")
  content     String
  status      String    @default("draft") // draft / published / offline
  authorId    String?   @map("author_id")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@map("classroom_articles")
}

model Comment {
  id               String   @id @default(uuid())
  postId           String   @map("post_id")
  commenterId      String   @map("commenter_id")
  content          String
  parentCommentId  String?  @map("parent_comment_id")
  /// published / offline / deleted
  status           String   @default("published")
  moderationReason String?  @map("moderation_reason")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  commenter User      @relation(fields: [commenterId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("ParentComment", fields: [parentCommentId], references: [id])
  replies   Comment[] @relation("ParentComment")

  @@index([postId, status, createdAt])
  @@index([commenterId])
  @@map("comments")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@map("favorites")
}

// ============================================
// 消息通知
// ============================================

model Notification {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  type             String // message / order / system
  title            String
  content          String
  referenceId      String?  @map("reference_id") // 关联的业务ID（订单ID、帖子ID等）
  /// 可空业务唯一去重键，防止重复评估创建相同通知。
  deduplicationKey String?  @unique @map("deduplication_key")
  isRead           Boolean  @default(false) @map("is_read")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// RBAC权限管理
// ============================================

model Role {
  id          String   @id @default(uuid())
  roleName    String   @unique @map("role_name")
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@index([isActive])
  @@map("roles")
}

model Permission {
  id             String   @id @default(uuid())
  permissionCode String   @unique @map("permission_code")
  permissionName String   @map("permission_name")
  module         String // user / order / content / finance / merchant / system
  type           String // menu / button / api
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@index([module])
  @@index([type])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model PermissionAuditLog {
  id            String   @id @default(uuid())
  operatorId    String   @map("operator_id")
  operationType String   @map("operation_type") // create_role / update_role / delete_role / assign_permission / remove_permission / assign_user_role / remove_user_role
  targetType    String   @map("target_type") // role / permission / user
  targetId      String   @map("target_id")
  changes       String? // JSON格式记录变更
  ip            String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([operatorId])
  @@index([createdAt])
  @@map("permission_audit_logs")
}

// ============================================
// 信用管理
// ============================================

model CreditScore {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  creditScore Int      @default(100) @map("credit_score")
  lastUpdated DateTime @default(now()) @map("last_updated")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([creditScore])
  @@map("credit_scores")
}

model CreditRecord {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  changeAmount      Int      @map("change_amount") // 正数增加，负数减少
  reason            String
  relatedOrderId    String?  @map("related_order_id")
  /// 触发信用变动的唯一业务引用，用于防止任务重复消费。
  businessReference String?  @unique @map("business_reference")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("credit_records")
}
