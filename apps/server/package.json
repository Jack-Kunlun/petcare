{
  "name": "@petcare/server",
  "version": "1.0.0",
  "description": "PetCare后端API服务",
  "scripts": {
    "predev": "pnpm --filter @petcare/shared-types build",
    "prebuild": "pnpm prisma:generate",
    "dev": "pnpm start:dev",
    "build": "nest build",
    "pretypecheck": "pnpm --filter @petcare/shared-types build && pnpm prisma:generate",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:staged": "prettier --write \"src/**/*.ts\"",
    "start": "node --env-file-if-exists=../../.env node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node --env-file-if-exists=../../.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "node --env-file-if-exists=../../.env node_modules/@nestjs/cli/bin/nest.js start --debug --watch",
    "start:prod": "node --env-file-if-exists=../../.env dist/main.js",
    "lint": "eslint .",
    "lint:staged": "eslint . --fix",
    "pretest": "pnpm prisma:generate",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "pretest:cov": "pnpm prisma:generate",
    "test:cov": "jest --coverage --runInBand",
    "pretest:coverage": "pnpm prisma:generate",
    "test:coverage": "jest --coverage --runInBand",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "pretest:e2e": "pnpm prisma:generate",
    "test:e2e": "node --env-file-if-exists=../../.env node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:push": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js db push",
    "prisma:seed": "node --env-file-if-exists=../../.env node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "clean": "node ../../scripts/clean.mjs dist coverage .turbo"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@petcare/shared-types": "workspace:*",
    "@petcare/shared-utils": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "^0.45.0",
    "bullmq": "^5.80.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "probe-image-size": "^7.3.0",
    "redis": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@petcare/eslint-config-base": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "jest-environment-node": "30.4.1",
    "prettier": "3.9.0",
    "prisma": "7.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
