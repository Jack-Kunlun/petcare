{
  "name": "@petcare/uniapp",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev": "pnpm dev:h5",
    "dev:app-android": "uni -p app-android",
    "dev:app-ios": "uni -p app-ios",
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build": "pnpm build:h5",
    "build:app-android": "uni build -p app-android",
    "build:app-ios": "uni build -p app-ios",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "clean": "node ../../scripts/clean.mjs dist coverage .turbo"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4080520251106001",
    "@dcloudio/uni-app-plus": "3.0.0-4080520251106001",
    "@dcloudio/uni-components": "3.0.0-4080520251106001",
    "@dcloudio/uni-h5": "3.0.0-4080520251106001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4080520251106001",
    "@wot-ui/ui": "^2.3.1",
    "@wot-ui/unocss-preset": "0.0.1-beta.4",
    "tslib": "2.8.1",
    "vue": "~3.4.38"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.12",
    "@dcloudio/vite-plugin-uni": "3.0.0-4080520251106001",
    "@petcare/eslint-config-base": "workspace:*",
    "@types/node": "^20.16.2",
    "@uni-helper/eslint-config": "^0.5.0",
    "@uni-helper/plugin-uni": "^0.1.0",
    "@uni-helper/uni-types": "^1.1.0",
    "@uni-helper/unocss-preset-uni": "^0.2.11",
    "@uni-helper/vite-plugin-uni-components": "^0.2.6",
    "@uni-helper/vite-plugin-uni-manifest": "^0.2.12",
    "@uni-helper/vite-plugin-uni-pages": "^0.3.23",
    "@unocss/eslint-config": "^66.5.6",
    "@vitest/coverage-v8": "^2.0.5",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.39.1",
    "miniprogram-api-typings": "^3.12.3",
    "sass": "^1.99.0",
    "typescript": "~5.5.4",
    "unocss": "66.7.5",
    "unplugin-auto-import": "^0.18.2",
    "vite": "^5.2.8",
    "vitest": "^2.0.5",
    "vue-tsc": "^2.0.29"
  }
}
