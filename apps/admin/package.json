{
  "name": "@petcare/admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @petcare/shared-types build",
    "prebuild": "pnpm --filter @petcare/shared-types build",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node ../../scripts/style-output-policy.mjs admin dist",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "pnpm lint:styles && eslint .",
    "lint:styles": "node ../../scripts/style-policy.mjs admin",
    "lint:staged": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:staged": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node e2e/run-e2e.mjs",
    "test:e2e:ui": "node e2e/run-e2e.mjs --ui",
    "test:e2e:debug": "node e2e/run-e2e.mjs --debug",
    "clean": "node ../../scripts/clean.mjs dist coverage playwright-report test-results .turbo"
  },
  "dependencies": {
    "@petcare/api-client": "workspace:*",
    "@petcare/shared-types": "workspace:*",
    "@petcare/shared-utils": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-query": "5.100.14",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@petcare/eslint-config-base": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "sass": "1.102.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
