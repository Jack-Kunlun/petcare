---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import MarketingPage from "../../components/MarketingPage.astro";
import { marketingPages } from "../../content/marketing";
import { createWebsiteContentApi } from "../../lib/api";
import { getWebsiteRuntimeConfig } from "../../lib/runtime-config";
import { CLASSROOM_ARTICLE_CATEGORY_LABELS } from "@petcare/shared-types";

const runtimeConfig = getWebsiteRuntimeConfig();
const api = createWebsiteContentApi({ baseUrl: runtimeConfig.contentApiBaseUrl });
const rawPage = Number(Astro.url.searchParams.get("page") ?? "1");
const page = Number.isInteger(rawPage) && rawPage > 0 ? rawPage : 1;
let articles: Awaited<ReturnType<typeof api.getArticles>> | null = null;
let shell: { sections: unknown[] } = { sections: [] };

try {
  [articles, shell] = await Promise.all([
    api.getArticles({ page, pageSize: 20 }),
    api.getPublished("site_shell").catch(() => ({ sections: [] })),
  ]);
} catch {
  articles = null;
}

const categories = [
  ...new Set(
    articles?.list.flatMap((article) => (article.category ? [article.category] : [])) ?? [],
  ),
];
const articleGroups = [
  ...categories.map((category) => ({
    id: `category-${category}`,
    label: CLASSROOM_ARTICLE_CATEGORY_LABELS[category],
    items: articles?.list.filter((article) => article.category === category) ?? [],
  })),
  ...(articles?.list.some((article) => article.category === null)
    ? [
        {
          id: "category-other",
          label: "更多文章",
          items: articles?.list.filter((article) => article.category === null) ?? [],
        },
      ]
    : []),
];
const emptyMessage = articles ? "目前还没有已发布的文章。" : "文章列表暂时无法加载，请稍后再试。";
---

{
  articles && articles.list.length > 0 ? (
    <ArticleLayout
      shell={shell}
      title="宠物课堂 | PetCare 宠伴"
      description="PetCare 宠物课堂的已发布养宠知识与实用指南。"
      canonical={new URL("/articles", runtimeConfig.publicUrl).toString()}
    >
      <section
        id="article-list-all"
        class="article-list content-container"
        aria-labelledby="article-list-title"
      >
        <header class="article-list__intro">
          <p class="eyebrow">PETCARE · 生活阅读</p>
          <h1 id="article-list-title">宠物课堂</h1>
          <p>把照护知识放进生活，把日常观察慢慢留下。</p>
          {articleGroups.length > 0 ? (
            <nav class="article-list__categories" aria-label="文章分类目录">
              <a href="#article-list-all" aria-current="page">
                全部
              </a>
              {articleGroups.map((group) => (
                <a href={`#${group.id}`}>{group.label}</a>
              ))}
            </nav>
          ) : null}
        </header>
        {articleGroups.map((group) => (
          <section id={group.id} class="article-list__category-section" aria-label={group.label}>
            <h2 class="sr-only">{group.label}</h2>
            <ol class="article-list__items">
              {group.items.map((article) => (
                <li>
                  <article>
                    {article.coverUrl ? <img src={article.coverUrl} alt="" loading="lazy" /> : null}
                    <div>
                      {article.category ? (
                        <span class="marketing-page__card-label">
                          {CLASSROOM_ARTICLE_CATEGORY_LABELS[article.category]}
                        </span>
                      ) : null}
                      <h3>
                        <a href={`/articles/${encodeURIComponent(article.slug)}`}>
                          {article.title}
                        </a>
                      </h3>
                      <p>{article.summary}</p>
                      <a class="text-link" href={`/articles/${encodeURIComponent(article.slug)}`}>
                        阅读全文 <span class="icon-arrow" aria-hidden="true" />
                      </a>
                    </div>
                  </article>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </section>
    </ArticleLayout>
  ) : (
    <MarketingPage page={marketingPages.articles} emptyMessage={emptyMessage} />
  )
}
