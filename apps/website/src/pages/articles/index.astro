---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { createWebsiteContentApi } from "../../lib/api";
import { getWebsiteRuntimeConfig } from "../../lib/runtime-config";

const runtimeConfig = getWebsiteRuntimeConfig();
const api = createWebsiteContentApi({ baseUrl: runtimeConfig.contentApiBaseUrl });
const rawPage = Number(Astro.url.searchParams.get("page") ?? "1");
const page = Number.isInteger(rawPage) && rawPage > 0 ? rawPage : 1;
let articles;
let shell: { sections: unknown[] } = { sections: [] };

try {
  [articles, shell] = await Promise.all([
    api.getArticles({ page, pageSize: 20 }),
    api.getPublished("site_shell").catch(() => ({ sections: [] })),
  ]);
} catch {
  Astro.response.status = 503;
}

const canonical = new URL("/articles", runtimeConfig.publicUrl).toString();

function formatDate(value: string): string {
  return new Intl.DateTimeFormat("zh-CN", { dateStyle: "long" }).format(new Date(value));
}
---

{
  articles ? (
    <ArticleLayout
      shell={shell}
      title="宠物课堂 | PetCare"
      description="PetCare 宠物课堂的已发布养宠知识与服务指南。"
      canonical={canonical}
    >
      <section class="article-list content-container" aria-labelledby="article-list-title">
        <p class="eyebrow">PetCare Classroom</p>
        <h1 id="article-list-title">宠物课堂</h1>
        <p class="section-description">已发布的养宠知识与服务指南。</p>
        {articles.list.length > 0 ? (
          <ol class="article-list__items">
            {articles.list.map((article) => (
              <li>
                <article>
                  <h2>
                    <a href={`/articles/${encodeURIComponent(article.slug)}`}>{article.title}</a>
                  </h2>
                  <p>{article.summary}</p>
                  {article.publishedAt ? (
                    <p class="article-meta">
                      <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
                      {article.author ? ` · ${article.author.displayName}` : ""}
                    </p>
                  ) : null}
                </article>
              </li>
            ))}
          </ol>
        ) : (
          <p>暂无已发布文章。</p>
        )}
      </section>
    </ArticleLayout>
  ) : (
    <html lang="zh-CN">
      <head>
        <>
          <meta charset="utf-8" />
          <meta name="robots" content="noindex" />
          <title>Service temporarily unavailable | PetCare</title>
        </>
      </head>
      <body>
        <main class="failure-page">
          <>
            <h1>Service temporarily unavailable</h1>
            <p>请稍后再试。</p>
          </>
        </main>
      </body>
    </html>
  )
}
