---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { WebsiteContentApiError, createWebsiteContentApi } from "../../lib/api";
import { getWebsiteRuntimeConfig } from "../../lib/runtime-config";

const runtimeConfig = getWebsiteRuntimeConfig();
const slug = Astro.params.slug;
const api = createWebsiteContentApi({ baseUrl: runtimeConfig.contentApiBaseUrl });
let article;
let shell: { sections: unknown[] } = { sections: [] };
let failureStatus: 404 | 503 | null = null;

if (!slug) {
  failureStatus = 404;
} else {
  try {
    [article, shell] = await Promise.all([
      api.getArticle(slug),
      api.getPublished("site_shell").catch(() => ({ sections: [] })),
    ]);
  } catch (error) {
    failureStatus = error instanceof WebsiteContentApiError && error.status === 404 ? 404 : 503;
  }
}

if (failureStatus) {
  Astro.response.status = failureStatus;
}

const canonical = slug
  ? new URL(`/articles/${encodeURIComponent(slug)}`, runtimeConfig.publicUrl).toString()
  : new URL("/articles", runtimeConfig.publicUrl).toString();
---

{
  article ? (
    <ArticleLayout
      shell={shell}
      title={`${article.title} | PetCare`}
      description={article.summary}
      canonical={canonical}
      image={article.coverUrl}
    >
      <article class="article-detail content-container">
        <header class="article-detail__header">
          <p class="eyebrow">PETCARE · 生活阅读</p>
          <h1>{article.title}</h1>
          <p class="section-description">{article.summary}</p>
          {article.publishedAt ? (
            <time class="sr-only" datetime={article.publishedAt}>
              发布时间：{article.publishedAt.slice(0, 10)}
            </time>
          ) : null}
        </header>
        {article.coverUrl ? (
          <img
            class="article-detail__cover"
            src={article.coverUrl}
            alt={article.title}
            loading="lazy"
          />
        ) : null}
        <div class="article-detail__body" set:html={article.bodyHtml} />
        <a class="article-detail__back" href="/articles">
          返回宠物课堂 <span aria-hidden="true">→</span>
        </a>
      </article>
    </ArticleLayout>
  ) : (
    <ArticleLayout
      shell={shell}
      title={
        failureStatus === 404
          ? "Article not found | PetCare"
          : "Service temporarily unavailable | PetCare"
      }
      description={
        failureStatus === 404 ? "该文章不存在或已下线。" : "文章服务暂时不可用，请稍后再试。"
      }
      canonical={canonical}
      noindex
    >
      <section class="failure-page" aria-labelledby="article-error-title">
        <h1 id="article-error-title">
          {failureStatus === 404 ? "Article not found" : "Service temporarily unavailable"}
        </h1>
        <p>{failureStatus === 404 ? "该文章不存在或已下线。" : "请稍后再试。"}</p>
        <a class="button" href="/articles">
          返回宠物课堂 <span class="icon-arrow" aria-hidden="true" />
        </a>
      </section>
    </ArticleLayout>
  )
}
