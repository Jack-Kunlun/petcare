---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { WebsiteContentApiError, createWebsiteContentApi } from "../../lib/api";
import { getWebsiteRuntimeConfig } from "../../lib/runtime-config";

const runtimeConfig = getWebsiteRuntimeConfig();
const slug = Astro.params.slug;
const api = createWebsiteContentApi({ baseUrl: runtimeConfig.contentApiBaseUrl });
let article;
let shell: { sections: unknown[] } = { sections: [] };
let failureStatus: 404 | 503 | null = null;

if (!slug) {
  failureStatus = 404;
} else {
  try {
    [article, shell] = await Promise.all([
      api.getArticle(slug),
      api.getPublished("site_shell").catch(() => ({ sections: [] })),
    ]);
  } catch (error) {
    failureStatus = error instanceof WebsiteContentApiError && error.status === 404 ? 404 : 503;
  }
}

if (failureStatus) {
  Astro.response.status = failureStatus;
}

const canonical = slug
  ? new URL(`/articles/${encodeURIComponent(slug)}`, runtimeConfig.publicUrl).toString()
  : new URL("/articles", runtimeConfig.publicUrl).toString();

function formatDate(value: string): string {
  return new Intl.DateTimeFormat("zh-CN", { dateStyle: "long" }).format(new Date(value));
}
---

{
  article ? (
    <ArticleLayout
      shell={shell}
      title={`${article.title} | PetCare`}
      description={article.summary}
      canonical={canonical}
      image={article.coverUrl}
    >
      <article class="article-detail content-container">
        <header>
          <p class="eyebrow">PetCare Classroom</p>
          <h1>{article.title}</h1>
          <p class="section-description">{article.summary}</p>
          {article.publishedAt ? (
            <p class="article-meta">
              <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
              {article.author ? ` · ${article.author.displayName}` : ""}
            </p>
          ) : null}
        </header>
        {article.coverUrl ? (
          <img src={article.coverUrl} alt={article.title} loading="lazy" />
        ) : null}
        <div class="article-detail__body">{article.body}</div>
      </article>
    </ArticleLayout>
  ) : (
    <html lang="zh-CN">
      <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex" />
        <title>
          {failureStatus === 404
            ? "Article not found | PetCare"
            : "Service temporarily unavailable | PetCare"}
        </title>
      </head>
      <body>
        <main class="failure-page">
          <h1>{failureStatus === 404 ? "Article not found" : "Service temporarily unavailable"}</h1>
          <p>{failureStatus === 404 ? "该文章不存在或已下线。" : "请稍后再试。"}</p>
          <a class="button" href="/articles">
            返回宠物课堂
          </a>
        </main>
      </body>
    </html>
  )
}
