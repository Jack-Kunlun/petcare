---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { readingArticles } from "../../content/reading";
import { WebsiteContentApiError, createWebsiteContentApi } from "../../lib/api";
import { getWebsiteRuntimeConfig } from "../../lib/runtime-config";

const runtimeConfig = getWebsiteRuntimeConfig();
const slug = Astro.params.slug;
const readingArticle = readingArticles.find((reading) => reading.slug === slug);
const api = createWebsiteContentApi({ baseUrl: runtimeConfig.contentApiBaseUrl });
let article;
let shell: { sections: unknown[] } = { sections: [] };
let failureStatus: 404 | 503 | null = null;

if (!slug) {
  failureStatus = 404;
} else if (!readingArticle) {
  try {
    [article, shell] = await Promise.all([
      api.getArticle(slug),
      api.getPublished("site_shell").catch(() => ({ sections: [] })),
    ]);
  } catch (error) {
    failureStatus =
      error instanceof WebsiteContentApiError &&
      error.status === 404 &&
      error.code === "CONTENT_ARTICLE_NOT_FOUND"
        ? 404
        : 503;
  }
}

if (failureStatus) {
  Astro.response.status = failureStatus;
}

const canonical = slug
  ? new URL(`/articles/${encodeURIComponent(slug)}`, runtimeConfig.publicUrl).toString()
  : new URL("/articles", runtimeConfig.publicUrl).toString();
const visibleArticle = readingArticle ?? article;
---

{
  visibleArticle ? (
    <ArticleLayout
      shell={shell}
      title={`${visibleArticle.title} | PetCare`}
      description={readingArticle?.introduction ?? visibleArticle.summary}
      canonical={canonical}
      image={visibleArticle.coverUrl}
    >
      <article
        class:list={[
          "article-detail",
          "content-container",
          readingArticle && "article-detail--reading",
        ]}
      >
        <header class="article-detail__header">
          <p class="eyebrow">
            生活阅读{readingArticle ? ` · ${readingArticle.categoryLabel}` : ""}
          </p>
          <h1>{visibleArticle.title}</h1>
          <p class="section-description">
            {readingArticle?.introduction ?? visibleArticle.summary}
          </p>
          {article?.publishedAt ? (
            <time class="sr-only" datetime={article.publishedAt}>
              发布时间：{article.publishedAt.slice(0, 10)}
            </time>
          ) : null}
        </header>
        {visibleArticle.coverUrl ? (
          <img
            class="article-detail__cover"
            src={visibleArticle.coverUrl}
            alt={readingArticle?.imageAlt ?? visibleArticle.title}
            loading="lazy"
          />
        ) : null}
        {readingArticle ? (
          <div class="article-detail__body">
            {readingArticle.sections.map((section) => (
              <section>
                <h2>{section.title}</h2>
                <p>{section.body}</p>
              </section>
            ))}
          </div>
        ) : article ? (
          <div class="article-detail__body" set:html={article.bodyHtml} />
        ) : null}
        <a class="article-detail__back" href="/articles">
          返回生活阅读 <span aria-hidden="true">→</span>
        </a>
      </article>
    </ArticleLayout>
  ) : (
    <ArticleLayout
      shell={shell}
      title={
        failureStatus === 404
          ? "Article not found | PetCare"
          : "Service temporarily unavailable | PetCare"
      }
      description={
        failureStatus === 404 ? "该文章不存在或已下线。" : "文章服务暂时不可用，请稍后再试。"
      }
      canonical={canonical}
      noindex
    >
      <section class="failure-page" aria-labelledby="article-error-title">
        <h1 id="article-error-title">
          {failureStatus === 404 ? "Article not found" : "Service temporarily unavailable"}
        </h1>
        <p>{failureStatus === 404 ? "该文章不存在或已下线。" : "请稍后再试。"}</p>
        <a class="button" href="/articles">
          返回宠物课堂 <span class="icon-arrow" aria-hidden="true" />
        </a>
      </section>
    </ArticleLayout>
  )
}
