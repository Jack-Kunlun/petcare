---
import { getHelpArticle } from "../../content/help";
import PublicPage from "../../components/PublicPage.astro";

const article = getHelpArticle(Astro.params.slug);
if (!article) Astro.response.status = 404;
---

{
  article ? (
    <PublicPage title={`${article.title} | 帮助中心 | PetCare 宠伴`} description={article.summary}>
      <main id="main-content" class="help-detail">
        <div class="content-container help-detail__inner">
          <nav class="help-detail__breadcrumb" aria-label="当前位置">
            <a href="/help">产品体验指南</a>
            <span aria-hidden="true">·</span>
            <span>{article.category}</span>
          </nav>
          <article class="help-detail__article" aria-labelledby="help-detail-title">
            <header class="help-detail__opening" data-scroll-reveal>
              <h1 id="help-detail-title">{article.title}</h1>
              <p class="help-detail__summary">{article.summary}</p>
            </header>
            <div class="help-detail__content" data-scroll-reveal>
              <p>{article.answer}</p>
              <ol class="help-detail__steps" aria-label="操作步骤">
                {article.steps.map((step, index) => (
                  <li>
                    <span class="help-detail__step-number" aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <div>
                      <h2>第 {index + 1} 步</h2>
                      <p>{step}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          </article>
          <footer class="help-detail__footer">
            <a class="text-link" href="/help">
              返回帮助中心 <span class="icon-arrow" aria-hidden="true" />
            </a>
            <a class="text-link" href="/help#contact">
              查看帮助与反馈说明 <span class="icon-arrow" aria-hidden="true" />
            </a>
          </footer>
        </div>
      </main>
    </PublicPage>
  ) : (
    <html lang="zh-CN">
      <head>
        <>
          <meta charset="utf-8" />
          <meta name="robots" content="noindex" />
          <title>帮助内容不存在 | PetCare</title>
        </>
      </head>
      <body>
        <main class="failure-page">
          <>
            <h1>帮助内容不存在</h1>
            <p>这条帮助可能已移动或下线。</p>
            <a class="button" href="/help">
              返回帮助中心 <span class="icon-arrow" aria-hidden="true" />
            </a>
          </>
        </main>
      </body>
    </html>
  )
}
