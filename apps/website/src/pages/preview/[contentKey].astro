---
import { createWebsiteContentApi } from "../../lib/api";
import { loadPreviewPageContent } from "../../lib/load-page-content";
import { getWebsiteRuntimeConfig } from "../../lib/runtime-config";
import PreviewLayout from "../../layouts/PreviewLayout.astro";
import { WEBSITE_PREVIEW_COOKIE } from "./session";

const contentKey = Astro.params.contentKey;
const previewToken = Astro.cookies.get(WEBSITE_PREVIEW_COOKIE)?.value;

if (!previewToken || !contentKey || contentKey === "site_shell") {
  return Astro.redirect("/preview", 302);
}

const api = createWebsiteContentApi({ baseUrl: getWebsiteRuntimeConfig().contentApiBaseUrl });
let content;

try {
  content = await loadPreviewPageContent({
    api,
    contentKey: contentKey as Exclude<
      Parameters<typeof loadPreviewPageContent>[0]["contentKey"],
      "site_shell"
    >,
    token: previewToken,
  });
} catch {
  return new Response("预览链接无效或已失效。", {
    status: 401,
    headers: {
      "Cache-Control": "private, no-store",
      "X-Robots-Tag": "noindex, nofollow",
      "content-type": "text/plain; charset=utf-8",
    },
  });
}

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
---

<PreviewLayout page={content.page} />
