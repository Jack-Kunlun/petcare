---
import PublicPage from "./PublicPage.astro";

const participationDetails = [
  ["身份资料", "按资格申请要求提供真实、清楚的身份信息。"],
  ["照护经验", "说明熟悉的宠物类型、照护经验与可提供的服务。"],
  ["范围与时间", "说明可服务区域、服务类型与可安排的时间。"],
  ["沟通与履约", "先确认习惯与约定，再按约完成照护与过程记录。"],
];

const participationSteps = [
  ["准备资料", "整理身份信息、照护经验、服务类型与范围。"],
  ["提交资格申请", "依申请要求提交资料，并查看申请进度。"],
  ["查看审核结果", "了解资格状态与适用的服务范围。"],
  ["确认并完成照护", "确认本次安排，按约完成照护和记录。"],
];
---

<PublicPage
  overlayHeader
  title="成为宠托师 | PetCare 宠伴"
  description="了解参与 PetCare 照护服务需要准备的资料、责任和资格流程。当前暂不受理资格申请。"
>
  <main id="main-content" class="interior-page interior-page--caregivers caregivers-page">
    <section class="interior-page__hero caregivers-page__hero" aria-labelledby="caregivers-title">
      <div class="interior-page__hero-scene">
        <img src="/brand/home/care-record.png" alt="" aria-hidden="true" fetchpriority="high" />
      </div>
      <div class="interior-page__hero-wash" aria-hidden="true"></div>
      <div class="interior-page__hero-inner content-container">
        <div class="interior-page__hero-copy">
          <p class="interior-page__eyebrow">成为宠托师 · 参与说明</p>
          <h1 id="caregivers-title"><span>认真</span>照护，<br />值得被看见。</h1>
          <p class="interior-page__hero-description">
            从了解宠物的习惯，到确认照护范围，再到记录每一步进展。认真照护，从清楚的约定开始。
          </p>
          <a class="interior-page__button" href="#caregiver-participation">了解参与方式</a>
        </div>
      </div>
      <img
        class="interior-page__hero-wave"
        src="/brand/interior/caregivers-wave.svg"
        alt=""
        aria-hidden="true"
      />
    </section>

    <section
      id="caregiver-participation"
      class="interior-page__section content-container caregivers-page__responsibility"
      aria-labelledby="caregivers-responsibility-title"
    >
      <div class="caregivers-page__responsibility-copy">
        <h2 id="caregivers-responsibility-title">把责任和范围说清楚。</h2>
        <p>参与照护，需要真实资料、相符经验，以及能够按约沟通和履行服务的准备。</p>
        <p class="interior-page__notice" role="note">本页提供参与说明，暂不受理资格申请。</p>
        <a class="interior-page__text-link" href="/product">探索产品体验 →</a>
      </div>
      <article class="caregivers-page__details">
        <p class="interior-page__card-label">参与资料</p>
        {
          participationDetails.map(([title, description]) => (
            <section>
              <h3>{title}</h3>
              <p>{description}</p>
            </section>
          ))
        }
      </article>
    </section>

    <section
      class="interior-page__section content-container caregivers-page__path"
      aria-labelledby="caregivers-path-title"
    >
      <div class="caregivers-page__path-intro">
        <h2 id="caregivers-path-title">从准备资料，<br />到完成照护。</h2>
        <p>资格申请与审核是参与流程的一部分。确认安排后，再按约完成照护与记录。</p>
        <figure class="interior-page__photo">
          <img src="/brand/home/walk.png" alt="宠物主人牵着金毛在户外散步" loading="lazy" />
        </figure>
      </div>
      <ol class="caregivers-page__steps" aria-label="参与流程说明">
        {
          participationSteps.map(([title, description], index) => (
            <li>
              <span aria-hidden="true">0{index + 1}</span>
              <div>
                <>
                  <h3>{title}</h3>
                  <p>{description}</p>
                </>
              </div>
            </li>
          ))
        }
        <li class="caregivers-page__step-note">
          <p>当前不开放申请入口；流程内容仅作参与说明，实际资格与服务范围以审核状态为准。</p>
        </li>
      </ol>
    </section>

    <section class="interior-page__closing content-container caregivers-page__closing">
      <div>
        <h2>先看看宠物主人的照护体验。</h2>
        <a class="interior-page__button" href="/care">了解照护服务</a>
      </div>
    </section>
  </main>
</PublicPage>
