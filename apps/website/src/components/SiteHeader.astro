---
import type { WebsitePublicSiteHeaderSection } from "./sections/public-section-types";
import { getSafeWebsiteHref } from "./sections/safe-rendering";

interface Props {
  /** Validated public site-header section. */
  section?: WebsitePublicSiteHeaderSection;
  /** Whether this is a preview render whose navigation should remain visibly scoped. */
  preview?: boolean;
  /** Uses the code-owned public website navigation instead of managed shell content. */
  static?: boolean;
  /** Uses the homepage header design and navigation. */
  home?: boolean;
}

const { section, preview = false, static: useStatic = false, home = false } = Astro.props;
const designShell = home || useStatic;
const homeNavigation = [
  { label: "产品体验", href: "/product" },
  { label: "照护服务", href: "/care" },
  { label: "生活阅读", href: "/articles" },
  { label: "帮助中心", href: "/help" },
  { label: "关于宠伴", href: "/about" },
];
const navigation: { label: string; href: string; mobileOnly?: boolean }[] = designShell
  ? homeNavigation
      .flatMap((item) =>
        !home && item.href === "/articles"
          ? [item, { label: "社区故事", href: "/stories", mobileOnly: true }]
          : [item],
      )
      .concat(home ? [] : [{ label: "成为宠托师", href: "/caregivers", mobileOnly: true }])
  : (section?.content.navigation ?? []);
const action = designShell
  ? { label: "探索产品体验", href: home ? "#product-experience" : "/product" }
  : section?.content.action;
const brandLabel =
  home || useStatic ? "PetCare 宠伴" : (section?.content.brandLabel ?? "PetCare 宠伴");
const headerClass = designShell
  ? `site-header site-header--home${home ? "" : " site-header--interior"}`
  : useStatic || !section || section.settings.sticky
    ? "site-header site-header--sticky"
    : "site-header";
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? currentPath === href : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class={headerClass} data-preview={preview ? "true" : undefined} data-site-header>
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label={brandLabel}>
      {
        designShell ? (
          <img src="/brand/home/symbol.svg" alt="" />
        ) : (
          <img src="/brand/petcare-symbol-color.svg" width="32" height="32" alt="" />
        )
      }
      <span>{brandLabel}</span>
    </a>
    <button
      class="site-header__menu-button"
      type="button"
      aria-label="打开导航"
      aria-expanded="false"
      aria-controls="site-navigation"
      data-site-menu-button
    >
      <span class="sr-only" data-site-menu-label>打开导航</span>
      {
        designShell ? (
          <img class="site-header__home-menu-icon" src="/brand/home/menu.svg" alt="" />
        ) : (
          <span class="site-header__menu-icon" aria-hidden="true">
            <>
              <i />
              <i />
              <i />
            </>
          </span>
        )
      }
    </button>
    <nav
      id="site-navigation"
      class="site-header__navigation"
      aria-label="主导航"
      data-site-navigation
    >
      {
        designShell ? (
          <div class="site-header__home-menu-heading">
            <h2>{home ? "探索宠伴" : "PetCare 宠伴"}</h2>
            {!home && (
              <button
                class="site-header__interior-menu-close"
                type="button"
                aria-label="关闭导航"
                data-site-menu-close
              >
                ×
              </button>
            )}
          </div>
        ) : null
      }
      <ul>
        {
          navigation.map((item) => {
            const href =
              home && item.href.startsWith("#") ? item.href : getSafeWebsiteHref(item.href);
            const current = href ? isCurrent(href) : false;
            const homeExperienceSelected = home && currentPath === "/" && item.href === "/product";

            return href ? (
              <li class:list={[item.mobileOnly && "site-header__mobile-link"]}>
                <a
                  href={href}
                  aria-current={current ? "page" : undefined}
                  data-current={current || homeExperienceSelected ? "true" : undefined}
                >
                  {useStatic && !home && item.href === "/articles" ? (
                    <>
                      <span class="site-header__desktop-label">生活阅读</span>
                      <span class="site-header__mobile-label">宠物课堂</span>
                    </>
                  ) : (
                    item.label
                  )}
                </a>
              </li>
            ) : null;
          })
        }
      </ul>
      {
        home && (
          <button class="site-header__home-menu-close" type="button" data-site-menu-close>
            关闭菜单 <span aria-hidden="true">×</span>
          </button>
        )
      }
      {
        action
          ? (() => {
              const href =
                home && action.href.startsWith("#") ? action.href : getSafeWebsiteHref(action.href);

              return href ? (
                <a
                  class="button button--compact"
                  href={href}
                  aria-current={isCurrent(href) ? "page" : undefined}
                >
                  {action.label}
                  {!designShell ? <span class="icon-arrow" aria-hidden="true" /> : null}
                </a>
              ) : null;
            })()
          : null
      }
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-site-menu-button]");
  const navigation = document.querySelector<HTMLElement>("[data-site-navigation]");
  const closeButton = document.querySelector<HTMLButtonElement>("[data-site-menu-close]");
  const label = button?.querySelector<HTMLElement>("[data-site-menu-label]");

  const setOpen = (open: boolean) => {
    button?.setAttribute("aria-expanded", String(open));
    button?.setAttribute("aria-label", open ? "关闭导航" : "打开导航");

    if (label) {
      label.textContent = open ? "关闭导航" : "打开导航";
    }

    navigation?.toggleAttribute("data-open", open);
  };

  button?.addEventListener("click", () => {
    setOpen(button.getAttribute("aria-expanded") !== "true");
  });

  closeButton?.addEventListener("click", () => {
    setOpen(false);
    button?.focus();
  });

  navigation?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || button?.getAttribute("aria-expanded") !== "true") {
      return;
    }

    setOpen(false);
    button?.focus();
  });
</script>
