---
import HomeExperience from "./HomeExperience.astro";
---

<header class="site-header site-header--sticky" data-site-header>
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="PetCare 宠伴首页">
      <img src="/brand/petcare-symbol-color.svg" width="32" height="32" alt="" />
      <span>PetCare 宠伴</span>
    </a>
    <button
      class="site-header__menu-button"
      type="button"
      aria-label="打开导航"
      aria-expanded="false"
      aria-controls="site-navigation"
    >
      <span class="sr-only">打开导航</span>
      <span class="site-header__menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
    <nav id="site-navigation" class="site-header__navigation" aria-label="主导航">
      <ul>
        <li><a href="/" aria-current="page">首页</a></li>
        <li><a href="#home-services">当前能力</a></li>
        <li><a href="#service-journey">使用路径</a></li>
        <li><a href="#community-preview">宠物生活</a></li>
        <li><a href="/articles">帮助中心</a></li>
      </ul>
      <a class="button button--compact" href="#home-download">开始了解</a>
    </nav>
  </div>
</header>

<main id="main-content">
  <section
    class="hero-section hero-section--background home-hero"
    aria-labelledby="home-hero-title"
  >
    <img
      class="hero-section__background-media"
      src="/brand/hero-community-companion-desktop-v1.webp"
      width="1920"
      height="720"
      alt="猫和狗在自然光下安心相伴"
      fetchpriority="high"
    />
    <div class="hero-section__inner">
      <div class="hero-section__content">
        <p class="eyebrow">PetCare 宠伴 · 个人版</p>
        <h1 id="home-hero-title">让每一份牵挂，<br />都有回应</h1>
        <p class="hero-section__description">
          从宠物档案、养宠课堂到受控社区，把每一次照顾和每一个值得记住的瞬间，整理成清楚、可回看的日常。
        </p>
        <div class="section-actions">
          <a class="button" href="#home-services">查看当前能力</a>
          <a class="button button--secondary" href="/articles">阅读养宠内容</a>
        </div>
        <p class="hero-section__trust-line">
          <span>本人宠物档案</span>
          <span>萌宠课堂</span>
          <span>受控社区</span>
          <span>真实状态可查</span>
        </p>
      </div>
    </div>
  </section>

  <HomeExperience />

  <section
    id="home-download"
    class="cta-section home-download"
    aria-labelledby="home-download-title"
  >
    <div class="content-container">
      <p class="eyebrow">从一次记录开始</p>
      <h2 id="home-download-title">把对它的牵挂，变成看得见的日常。</h2>
      <p>
        先从宠物档案开始，记录基本资料、日常习惯和照片；再去阅读可靠内容，慢慢建立属于你和它的生活记录。
      </p>
      <div class="section-actions">
        <a class="button" href="/about">了解 PetCare</a>
        <a class="button button--secondary" href="/contact">联系我们</a>
      </div>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="site-footer__inner">
    <section class="site-footer__brand" aria-label="PetCare">
      <img src="/brand/petcare-symbol-reverse.svg" width="40" height="40" alt="" loading="lazy" />
      <strong>PetCare 宠伴</strong>
      <p>让爱在生活里更好，记录每一次认真陪伴。</p>
    </section>
    <section aria-labelledby="footer-about">
      <h2 id="footer-about">了解 PetCare</h2>
      <ul>
        <li><a href="/about">关于我们</a></li>
        <li><a href="/contact">联系我们</a></li>
      </ul>
    </section>
    <section aria-labelledby="footer-help">
      <h2 id="footer-help">帮助与规则</h2>
      <ul>
        <li><a href="/articles">帮助中心</a></li>
        <li><a href="/terms">服务协议</a></li>
        <li><a href="/privacy">隐私政策</a></li>
      </ul>
    </section>
  </div>
  <p class="site-footer__copyright">© 2024 PetCare. 保留所有权利。</p>
</footer>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>(".site-header__menu-button");
  const navigation = document.querySelector<HTMLElement>(".site-header__navigation");
  const setMenuOpen = (open: boolean) => {
    menuButton?.setAttribute("aria-expanded", String(open));
    menuButton?.setAttribute("aria-label", open ? "关闭导航" : "打开导航");
    navigation?.toggleAttribute("data-open", open);
  };

  menuButton?.addEventListener("click", () => {
    setMenuOpen(menuButton.getAttribute("aria-expanded") !== "true");
  });
  navigation
    ?.querySelectorAll("a")
    .forEach((link) => link.addEventListener("click", () => setMenuOpen(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menuButton?.getAttribute("aria-expanded") === "true") {
      setMenuOpen(false);
      menuButton.focus();
    }
  });

  const revealTargets = [
    ".home-hero .hero-section__content > *",
    ".home-services .section-heading",
    ".service-story",
    ".service-journey-section .section-heading",
    ".service-journey li",
    ".service-record-demo",
    ".service-record-section__copy",
    ".safety-section .section-heading",
    ".safety-details li",
    ".community-preview .section-heading",
    ".community-story",
    ".brand-story-section__inner > div",
    ".home-download .content-container > *",
  ];
  const revealElements = revealTargets.flatMap((selector) =>
    Array.from(document.querySelectorAll<HTMLElement>(selector)),
  );

  document.documentElement.dataset.motion = "ready";
  revealElements.forEach((element, index) => {
    element.setAttribute("data-scroll-reveal", "");
    element.style.setProperty("--reveal-delay", `${Math.min(index % 5, 4) * 70}ms`);
  });

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) =>
        entries.forEach(
          (entry) => entry.isIntersecting && entry.target.setAttribute("data-visible", "true"),
        ),
      { threshold: 0.05, rootMargin: "0px 0px 18% 0px" },
    );

    revealElements.forEach((element) => observer.observe(element));
  } else {
    revealElements.forEach((element) => element.setAttribute("data-visible", "true"));
  }

  const hero = document.querySelector<HTMLElement>(".home-hero");
  let frame = 0;
  const updateScroll = () => {
    frame = 0;
    hero?.style.setProperty("--hero-shift", `${Math.min(window.scrollY * 0.08, 48)}px`);
  };

  window.addEventListener(
    "scroll",
    () => {
      if (!frame) {
        frame = window.requestAnimationFrame(updateScroll);
      }
    },
    { passive: true },
  );
  updateScroll();
</script>
