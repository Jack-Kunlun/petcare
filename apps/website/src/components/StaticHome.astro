---
import CarePreview from "./CarePreview.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

const moments = [
  { image: "walk", alt: "主人牵着金毛沿着花园小路散步", caption: "沿着熟悉的路，慢慢走。" },
  { image: "home", alt: "橘猫在主人身旁的书桌上休息", caption: "把日常写下来。" },
  { image: "together", alt: "主人与金毛依偎在湖边", caption: "熟悉的陪伴，一直在身边。" },
];
---

<a class="skip-link" href="#main-content">跳到主要内容</a>
<SiteHeader static home />

<main id="main-content" class="home-landing">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__photography">
      <img
        src="/brand/home/hero.png"
        width="1774"
        height="887"
        alt="猫与金毛在明亮的家中安心相伴"
        fetchpriority="high"
      />
    </div>
    <div class="home-hero__fade" aria-hidden="true"></div>
    <div class="home-hero__wave" aria-hidden="true"></div>
    <div class="home-container home-hero__inner">
      <div class="home-hero__copy">
        <p class="home-eyebrow">陪伴每一次托付</p>
        <h1 id="home-title">放心出发，<br />它会被<span>认真</span>照顾。</h1>
        <p class="home-hero__lead">从宠物档案到照护记录，<br />让重要的日常与托付安排清楚。</p>
        <div class="home-hero__actions">
          <a class="home-button" href="#product-experience">探索产品体验</a>
          <a class="home-profile-link" href="#pet-profile">了解宠物档案 →</a>
        </div>
      </div>
    </div>
  </section>

  <section
    id="product-experience"
    class="home-container home-experience"
    aria-labelledby="home-experience-title"
  >
    <div id="pet-profile" class="home-profile">
      <p class="home-eyebrow">PETCARE · 产品体验</p>
      <h2 id="home-experience-title">看见照护进展，<br />也留住陪伴日常。</h2>
      <p class="home-profile__description">
        把生活习惯记入档案，把照护安排交接清楚。<br />从发布需求到完成反馈，跟进每一步进展。
      </p>
      <div class="home-profile-card" aria-label="宠物档案界面示例">
        <div class="home-profile-card__photo">
          <img
            src="/brand/home/care-record.png"
            width="1536"
            height="1024"
            alt="团子的档案照片"
            loading="lazy"
          />
        </div>
        <div class="home-profile-card__copy">
          <p>宠物档案</p>
          <h3>团子的日常</h3>
          <small>饮食 · 相处 · 照护备注</small>
        </div>
      </div>
    </div>
    <div class="home-care">
      <CarePreview />
      <div class="home-care__moments">
        <figure class="home-photo home-care__walk">
          <img
            src="/brand/home/walk.png"
            width="1536"
            height="1024"
            alt="主人与金毛在花园里散步"
            loading="lazy"
          /><figcaption>散步时光</figcaption>
        </figure>
        <figure class="home-photo home-care__rest">
          <img
            src="/brand/home/home.png"
            width="1536"
            height="1024"
            alt="橘猫在家中休息"
            loading="lazy"
          /><figcaption>回家休息</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="home-container home-community" aria-labelledby="home-community-title">
    <h2 id="home-community-title">陪伴，在平常的小事里。</h2>
    <p>从散步、居家到记录，让熟悉的日常继续发生。</p>
    <div class="home-community__photos">
      {
        moments.map((moment) => (
          <figure class="home-photo">
            <>
              <img
                src={`/brand/home/${moment.image}.png`}
                width="1536"
                height="1024"
                alt={moment.alt}
                loading="lazy"
              />
              <figcaption>{moment.caption}</figcaption>
            </>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="home-closing" aria-labelledby="home-closing-title">
    <div class="home-container home-closing__inner">
      <div class="home-closing__copy">
        <h2 id="home-closing-title">把照顾交接清楚，<br />把陪伴留在日常。</h2>
        <p>从了解它的日常，开始每一次认真的托付。</p>
        <a class="home-button" href="#product-experience">探索产品体验</a>
      </div>
      <div class="home-closing__photography">
        <img
          src="/brand/home/closing.png"
          width="1774"
          height="887"
          alt="金毛在阳光明亮的花园旁安心休息"
          loading="lazy"
        />
      </div>
    </div>
  </section>
</main>

<SiteFooter static home />
