---
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

const steps = [
  {
    label: "发布需求",
    title: "先把需要说清楚",
    fields: [
      ["照护安排", "上门喂养与陪玩"],
      ["时间与备注", "按日常习惯确认"],
    ],
  },
  {
    label: "沟通确认",
    title: "把照顾逐项确认",
    fields: [
      ["沟通确认", "照护时间与具体事项"],
      ["交接重点", "饮食、相处与注意事项"],
    ],
  },
  {
    label: "跟进照护",
    title: "照护进展，随时可见",
    status: "照护进行中",
    updated: "更新时间 14:30",
    fields: [
      ["已完成", "查看状态 · 喂食 · 换水"],
      ["照护备注", "在熟悉的位置休息，饮水已更换。"],
    ],
  },
  {
    label: "完成反馈",
    title: "把这次陪伴留下来",
    status: "照护已完成",
    fields: [
      ["完成事项", "照护事项已回看"],
      ["照护记录", "照片与备注一起留存"],
    ],
  },
];
const moments = [
  { image: "walk", alt: "主人牵着金毛沿着花园小路散步", caption: "沿着熟悉的路，慢慢走。" },
  { image: "home", alt: "橘猫在主人身旁的书桌上休息", caption: "把日常写下来。" },
  { image: "together", alt: "主人与金毛依偎在湖边", caption: "熟悉的陪伴，一直在身边。" },
];
---

<a class="skip-link" href="#main-content">跳到主要内容</a>
<SiteHeader static home />

<main id="main-content" class="home-landing">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__photography">
      <img
        src="/brand/home/hero.png"
        width="1774"
        height="887"
        alt="猫与金毛在明亮的家中安心相伴"
        fetchpriority="high"
      />
    </div>
    <div class="home-hero__fade" aria-hidden="true"></div>
    <div class="home-hero__wave" aria-hidden="true"></div>
    <div class="home-container home-hero__inner">
      <div class="home-hero__copy">
        <p class="home-eyebrow">陪伴每一次托付</p>
        <h1 id="home-title">放心出发，<br />它会被<span>认真</span>照顾。</h1>
        <p class="home-hero__lead">从宠物档案到照护记录，<br />让重要的日常与托付安排清楚。</p>
        <div class="home-hero__actions">
          <a class="home-button" href="#product-experience">探索产品体验</a>
          <a class="home-profile-link" href="#pet-profile">了解宠物档案 →</a>
        </div>
      </div>
    </div>
  </section>

  <section
    id="product-experience"
    class="home-container home-experience"
    aria-labelledby="home-experience-title"
  >
    <div id="pet-profile" class="home-profile">
      <p class="home-eyebrow">PETCARE · 产品体验</p>
      <h2 id="home-experience-title">看见照护进展，<br />也留住陪伴日常。</h2>
      <p class="home-profile__description">
        把生活习惯记入档案，把照护安排交接清楚。<br />从发布需求到完成反馈，跟进每一步进展。
      </p>
      <div class="home-profile-card" aria-label="宠物档案界面示例">
        <div class="home-profile-card__photo">
          <img
            src="/brand/home/care-record.png"
            width="1536"
            height="1024"
            alt="团子的档案照片"
            loading="lazy"
          />
        </div>
        <div class="home-profile-card__copy">
          <p>宠物档案</p>
          <h3>团子的日常</h3>
          <small>饮食 · 相处 · 照护备注</small>
        </div>
      </div>
    </div>
    <div class="home-care">
      <div class="home-phone" aria-label="照护流程界面示例" data-care-preview>
        <div class="home-phone__status" aria-hidden="true">
          <span>9:41</span><span>● ▰ ●</span>
        </div>
        <div class="home-care-preview">
          <h3 class="home-care-preview__heading">照护手记</h3>
          <div class="home-care-preview__pet">
            <img src="/brand/home/walk.png" width="132" height="88" alt="" loading="lazy" />
            <div><strong>团子</strong><span>宠物档案</span></div>
          </div>
          <div class="home-care-tabs" role="tablist" aria-label="照护阶段">
            {
              steps.map((step, index) => (
                <button
                  id={`care-tab-${index}`}
                  type="button"
                  role="tab"
                  aria-selected={index === 2 ? "true" : "false"}
                  aria-controls={`care-panel-${index}`}
                  tabindex={index === 2 ? 0 : -1}
                  data-care-tab
                  data-complete={index < 2 ? "true" : undefined}
                >
                  <>
                    <span>{step.label}</span>
                    <small aria-hidden="true">{index < 2 ? "✓" : ""}</small>
                  </>
                </button>
              ))
            }
          </div>
          {
            steps.map((step, index) => (
              <div
                class="home-care-panel"
                id={`care-panel-${index}`}
                role="tabpanel"
                aria-labelledby={`care-tab-${index}`}
                hidden={index !== 2}
                data-care-panel
              >
                <h4>{step.title}</h4>
                <img
                  class="home-care-panel__photo"
                  src="/brand/home/care-record.png"
                  width="1536"
                  height="1024"
                  alt="主人在家中照顾金毛"
                  loading="lazy"
                />
                <div class="home-care-detail">
                  {step.status && (
                    <div class="home-care-detail__status">
                      <span>{step.status}</span>
                      <small>{step.updated ?? ""}</small>
                    </div>
                  )}
                  {step.fields.map(([label, value]) => (
                    <div class="home-care-detail__field">
                      <span>{label}</span>
                      <p>{value}</p>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
          <button class="home-care-next" type="button" data-care-next>接着看下一步</button>
        </div>
      </div>
      <div class="home-care__moments">
        <figure class="home-photo home-care__walk">
          <img
            src="/brand/home/walk.png"
            width="1536"
            height="1024"
            alt="主人与金毛在花园里散步"
            loading="lazy"
          /><figcaption>散步时光</figcaption>
        </figure>
        <figure class="home-photo home-care__rest">
          <img
            src="/brand/home/home.png"
            width="1536"
            height="1024"
            alt="橘猫在家中休息"
            loading="lazy"
          /><figcaption>回家休息</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="home-container home-community" aria-labelledby="home-community-title">
    <h2 id="home-community-title">陪伴，在平常的小事里。</h2>
    <p>从散步、居家到记录，让熟悉的日常继续发生。</p>
    <div class="home-community__photos">
      {
        moments.map((moment) => (
          <figure class="home-photo">
            <>
              <img
                src={`/brand/home/${moment.image}.png`}
                width="1536"
                height="1024"
                alt={moment.alt}
                loading="lazy"
              />
              <figcaption>{moment.caption}</figcaption>
            </>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="home-closing" aria-labelledby="home-closing-title">
    <div class="home-container home-closing__inner">
      <div class="home-closing__copy">
        <h2 id="home-closing-title">把照顾交接清楚，<br />把陪伴留在日常。</h2>
        <p>从了解它的日常，开始每一次认真的托付。</p>
        <a class="home-button" href="#product-experience">探索产品体验</a>
      </div>
      <div class="home-closing__photography">
        <img
          src="/brand/home/closing.png"
          width="1774"
          height="887"
          alt="金毛在阳光明亮的花园旁安心休息"
          loading="lazy"
        />
      </div>
    </div>
  </section>
</main>

<SiteFooter static home />

<script>
  const preview = document.querySelector<HTMLElement>("[data-care-preview]");
  const tabs = Array.from(preview?.querySelectorAll<HTMLButtonElement>("[data-care-tab]") ?? []);
  const panels = Array.from(preview?.querySelectorAll<HTMLElement>("[data-care-panel]") ?? []);
  const next = preview?.querySelector<HTMLButtonElement>("[data-care-next]");
  let current = 2;

  const selectStep = (index: number, focus = false) => {
    current = (index + tabs.length) % tabs.length;
    tabs.forEach((tab, position) => {
      tab.setAttribute("aria-selected", String(position === current));
      tab.tabIndex = position === current ? 0 : -1;
      tab.toggleAttribute("data-complete", position < current);
      const completion = tab.querySelector("small");

      if (completion) {
        completion.textContent = position < current ? "✓" : "";
      }
    });
    panels.forEach((panel, position) => {
      panel.hidden = position !== current;
    });

    if (next) {
      next.textContent = current === tabs.length - 1 ? "回看整个流程" : "接着看下一步";
    }

    if (focus) {
      tabs[current]?.focus();
    }
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => selectStep(index));
    tab.addEventListener("keydown", (event) => {
      if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) {
        return;
      }

      event.preventDefault();
      let target = index + (event.key === "ArrowRight" ? 1 : -1);

      if (event.key === "Home") {
        target = 0;
      } else if (event.key === "End") {
        target = tabs.length - 1;
      }

      selectStep(target, true);
    });
  });
  next?.addEventListener("click", () => selectStep(current + 1));
</script>
