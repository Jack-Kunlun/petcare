---
import MotionEnhancer from "./MotionEnhancer.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

const journey = [
  { number: "01", title: "发布悬赏", description: "写清楚时间、地点、照护内容和注意事项。" },
  { number: "02", title: "确认服务", description: "双方确认服务范围、步骤和交付边界。" },
  { number: "03", title: "查看进度", description: "按服务步骤查看过程记录和当前状态。" },
  { number: "04", title: "完成评价", description: "确认结果，处理异常，并留下评价记录。" },
];

const entryLinks = [
  { label: "宠物档案", href: "/for-pet-owners" },
  { label: "宠物课堂", href: "/articles" },
  { label: "服务者路径", href: "/for-providers" },
  { label: "帮助中心", href: "/help" },
];
---

<SiteHeader static />

<main id="main-content" class="home-refresh">
  <section class="home-refresh__hero" data-parallax aria-labelledby="home-refresh-title">
    <img
      class="home-refresh__hero-image"
      src="/brand/hero-community-companion-desktop-v1.webp"
      width="1920"
      height="720"
      alt="猫和狗在自然光下安心相伴"
      fetchpriority="high"
    />
    <div class="home-refresh__hero-overlay" aria-hidden="true"></div>
    <div class="content-container home-refresh__hero-inner">
      <div class="home-refresh__hero-copy" data-scroll-reveal>
        <p class="eyebrow">PetCare 宠伴</p>
        <h1 id="home-refresh-title">让每一次照护，都安心可见。</h1>
        <p>无论你在不在身边，都能把宠物的照护过程记录下来。</p>
        <a class="button" href="/miniapp">查看小程序入口 <span aria-hidden="true">→</span></a>
        <p class="home-refresh__entry-note">正式二维码以小程序发布配置为准。</p>
      </div>
    </div>
  </section>

  <section class="home-refresh__process" aria-labelledby="home-refresh-process-title">
    <div class="content-container">
      <header class="home-refresh__heading" data-scroll-reveal>
        <p class="eyebrow">一次照护，四个节点</p>
        <h2 id="home-refresh-process-title">从发布需求，到确认结果</h2>
        <p>把悬赏、订单和服务记录放在同一条清楚的路径里。</p>
      </header>
      <ol class="home-refresh__journey">
        {
          journey.map((item) => (
            <li>
              <span>{item.number}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <a class="text-link" href="/service-flow"
        >查看完整服务流程 <span aria-hidden="true">→</span></a
      >
    </div>
  </section>

  <section class="home-refresh__record" aria-labelledby="home-refresh-record-title">
    <div class="content-container home-refresh__record-inner">
      <div class="home-refresh__record-copy">
        <p class="eyebrow">记录与照护</p>
        <h2 id="home-refresh-record-title">重要的资料，不再散落在聊天记录里。</h2>
        <p>
          宠物档案、照护过程、图片和评价各自归位，需要时能快速找到上下文。先从一份宠物档案开始，再按需要使用课堂和服务流程。
        </p>
        <nav class="home-refresh__links" aria-label="PetCare 相关入口">
          {
            entryLinks.map((link) => (
              <a href={link.href}>
                {link.label}
                <span aria-hidden="true">→</span>
              </a>
            ))
          }
        </nav>
      </div>
      <figure class="home-refresh__record-visual">
        <img
          src="/brand/pet-life-feeding.jpg"
          width="960"
          height="720"
          alt="宠物在日常生活中的状态"
          loading="lazy"
        />
        <figcaption>宠物日常素材 · 记录每一次认真陪伴</figcaption>
      </figure>
    </div>
  </section>

  <section class="home-refresh__entry" aria-labelledby="home-refresh-entry-title">
    <div class="content-container">
      <p class="eyebrow">从一次记录开始</p>
      <h2 id="home-refresh-entry-title">下一次需要照护时，从 PetCare 开始。</h2>
      <p>小程序正式入口和二维码配置完成后，可直接从这里进入。</p>
      <a class="button" href="/miniapp">查看小程序入口 <span aria-hidden="true">→</span></a>
    </div>
  </section>
</main>

<SiteFooter static />
<MotionEnhancer />
