---
import MotionEnhancer from "./MotionEnhancer.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
---

<a class="skip-link" href="#main-content">跳到主要内容</a>
<SiteHeader static />

<main id="main-content" class="brand-home">
  <section class="brand-home__hero" data-parallax aria-labelledby="brand-home-title">
    <div class="content-container brand-home__hero-grid">
      <div class="brand-home__hero-copy" data-scroll-reveal>
        <p class="eyebrow">PetCare 宠伴</p>
        <h1 id="brand-home-title">忙碌的时候，<br /><em>也想把它照顾好。</em></h1>
        <p class="brand-home__lead">连接宠物主人与照护者，从一次照护需求开始。</p>
        <div class="brand-home__hero-actions">
          <a class="button" href="/start">发布照护需求 <span aria-hidden="true">→</span></a>
          <a class="text-link" href="/care">先了解照护方式 <span aria-hidden="true">→</span></a>
        </div>
        <p class="brand-home__microcopy">在微信小程序中使用</p>
      </div>
      <figure class="brand-home__hero-media" data-scroll-reveal>
        <img
          src="/brand/hero-community-companion-desktop-v1.webp"
          width="1920"
          height="720"
          alt="猫和狗在家中自然相伴"
          fetchpriority="high"
        />
        <figcaption>把看不见的牵挂，变成看得见的照护。</figcaption>
      </figure>
    </div>
  </section>

  <section class="brand-home__proof" aria-labelledby="brand-home-proof-title">
    <div class="content-container brand-home__proof-grid">
      <div class="brand-home__proof-copy" data-scroll-reveal>
        <p class="eyebrow">照护过程</p>
        <h2 id="brand-home-proof-title">不只是找到人，也要把过程说清楚。</h2>
        <p>
          从发布需求到完成反馈，照护信息沿着同一条记录留下来。你可以知道现在进行到哪一步，也知道下一步要做什么。
        </p>
        <a class="text-link" href="/care">查看完整照护方式 <span aria-hidden="true">→</span></a>
      </div>
      <div class="brand-home__record" data-scroll-reveal aria-label="照护记录界面示意">
        <div class="brand-home__record-heading">
          <div>
            <span class="brand-home__record-kicker">页面示意</span>
            <strong>一次照护记录</strong>
          </div>
          <span class="brand-home__record-state">进行中</span>
        </div>
        <ol class="brand-home__record-steps">
          <li class="is-complete">
            <span>01</span><strong>说清需求</strong><small>时间、地点和照护内容</small>
          </li>
          <li class="is-complete">
            <span>02</span><strong>沟通确认</strong><small>双方确认服务范围</small>
          </li>
          <li class="is-current">
            <span>03</span><strong>跟进照护</strong><small>按步骤留下过程记录</small>
          </li>
          <li><span>04</span><strong>完成反馈</strong><small>确认结果并留下评价</small></li>
        </ol>
        <div class="brand-home__record-photo">
          <img
            src="/brand/pet-life-feeding.jpg"
            width="640"
            height="480"
            alt="宠物在日常生活中的状态"
            loading="lazy"
          />
          <span>记录一段真实的日常</span>
        </div>
      </div>
    </div>
  </section>

  <section class="brand-home__routes" aria-labelledby="brand-home-routes-title">
    <div class="content-container brand-home__routes-inner">
      <div class="brand-home__routes-image" data-scroll-reveal>
        <img
          src="/brand/pet-life-playing.jpg"
          width="960"
          height="720"
          alt="人与宠物在户外相伴"
          loading="lazy"
        />
      </div>
      <div class="brand-home__routes-copy" data-scroll-reveal>
        <p class="eyebrow">接下来，从这里开始</p>
        <h2 id="brand-home-routes-title">你是想安排照护，还是愿意成为照护者？</h2>
        <p>两条路径，各自说清楚该做什么。官网负责介绍，小程序负责真正开始。</p>
        <div class="brand-home__route-links">
          <a href="/start"
            ><span>我需要照护</span><small>进入小程序发布需求</small><b aria-hidden="true">→</b></a
          >
          <a href="/caregivers"
            ><span>我想成为照护者</span><small>了解参与条件与责任</small><b aria-hidden="true">→</b
            ></a
          >
        </div>
      </div>
    </div>
  </section>
</main>

<SiteFooter static />
<MotionEnhancer />
