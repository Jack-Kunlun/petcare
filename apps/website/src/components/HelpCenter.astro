---
import { helpArticles } from "../content/help";
import PublicPage from "./PublicPage.astro";

const landingArticles = helpArticles.filter((article) => article.showOnLanding !== false);
const topicByHelpCategory = {
  使用与账号: "all",
  发布与沟通: "care",
  照护过程: "care",
  费用与售后: "rules",
  照护者帮助: "rules",
} as const;
const categories = [
  { id: "all", label: "全部问题", description: "档案、安排与记录", icon: "book" },
  { id: "care", label: "照护安排", description: "沟通、进度与反馈", icon: "care" },
  { id: "rules", label: "费用与规则", description: "费用确认与相关约定", icon: "fees" },
];
---

<PublicPage
  title="帮助中心 | PetCare 宠伴"
  description="查找宠物档案、照护安排、照护记录、费用规则与照护者资格相关说明。"
>
  <main id="main-content" class="help-center help-center--task">
    <section class="help-center__task-intro" aria-labelledby="help-center-title">
      <div class="content-container">
        <div class="help-center__opening">
          <div class="help-center__opening-copy">
            <p class="eyebrow">PETCARE · 帮助中心</p>
            <h1 id="help-center-title">
              照护的每一步，<br class="help-center__mobile-break" />都有<span>清楚</span>的指引。
            </h1>
            <p class="help-center__intro-copy">
              从认识宠物，到安排照护，<br class="help-center__mobile-break" />找到你关心的那一步。
            </p>
            <form class="help-center__search" role="search" data-help-search-form>
              <label class="sr-only" for="help-search">搜索帮助内容</label>
              <input
                id="help-search"
                name="q"
                type="search"
                autocomplete="off"
                placeholder="搜索你关心的问题"
                data-help-search
              />
              <button type="button" data-help-clear hidden>清空</button>
              <button class="help-center__search-submit" type="submit" aria-label="搜索帮助">
                <img src="/brand/help/search.svg" alt="" width="24" height="24" />
              </button>
            </form>
            <p class="help-center__status sr-only" aria-live="polite" data-help-status>
              共 {landingArticles.length} 个常见问题
            </p>
          </div>
          <figure class="help-center__hero-photo">
            <img src="/brand/home/home.png" alt="" width="384" height="216" fetchpriority="high" />
            <figcaption>先了解它，再把安排说清楚。</figcaption>
          </figure>
        </div>

        <nav class="help-center__categories" aria-label="帮助分类" data-help-category-nav>
          {
            categories.map((category, index) => (
              <button
                type="button"
                aria-pressed={index === 0 ? "true" : "false"}
                class:list={["help-center__category", index === 0 && "is-active"]}
                data-help-category={category.id}
              >
                <img
                  class="help-center__category-icon"
                  src={`/brand/help/${category.icon}.svg`}
                  alt=""
                  width="28"
                  height="28"
                />
                <span class="help-center__category-copy">
                  <span class="help-center__category-label">{category.label}</span>
                  <span class="help-center__category-description">{category.description}</span>
                </span>
              </button>
            ))
          }
        </nav>
      </div>
    </section>

    <section class="help-center__task-body" aria-labelledby="help-center-faq-title">
      <div class="content-container">
        <div class="help-center__answers-layout">
          <div class="help-center__faq-card">
            <header class="help-center__results-heading">
              <h2 id="help-center-faq-title">常见问题</h2>
            </header>
            <div class="help-center__faq-list help-center__faq-list--task" data-help-list>
              {
                landingArticles.map((article, index) => (
                  <article
                    data-help-item
                    data-help-article-category={article.category}
                    data-help-topic={topicByHelpCategory[article.category]}
                    data-search-text={`${article.title} ${article.summary} ${article.keywords} ${article.answer}`}
                  >
                    {index === 0 ? (
                      <details>
                        <summary>
                          <span>{article.title}</span>
                          <img
                            class="help-center__toggle-icon help-center__toggle-icon--plus"
                            src="/brand/help/plus.svg"
                            alt=""
                            width="24"
                            height="24"
                          />
                          <img
                            class="help-center__toggle-icon help-center__toggle-icon--minus"
                            src="/brand/help/minus.svg"
                            alt=""
                            width="24"
                            height="24"
                          />
                        </summary>
                        <div class="help-center__answer">
                          <p>{article.summary}</p>
                          <a href={`/help/${article.slug}`}>阅读完整指南 →</a>
                        </div>
                      </details>
                    ) : (
                      <a class="help-center__question-link" href={`/help/${article.slug}`}>
                        <span>{article.title}</span>
                        <img src="/brand/help/arrow.svg" alt="" width="24" height="24" />
                      </a>
                    )}
                  </article>
                ))
              }
            </div>
            <div class="help-center__empty" data-help-empty hidden>
              <h3>没有找到相关问题</h3>
              <p>试试更短的关键词，或先查看照护服务和小程序入口。</p>
              <div class="help-center__empty-links">
                <a class="text-link" href="/care">
                  查看照护服务 <span class="icon-arrow" aria-hidden="true"></span>
                </a>
                <a class="text-link" href="/start">
                  查看小程序入口 <span class="icon-arrow" aria-hidden="true"></span>
                </a>
              </div>
            </div>
          </div>

          <aside class="help-center__sidebar" aria-label="更多阅读与反馈">
            <img
              class="help-center__sidebar-photo"
              src="/brand/home/home.png"
              alt=""
              width="342"
              height="192"
              loading="lazy"
            />
            <section class="help-center__reading" aria-labelledby="help-center-reading-title">
              <h2 id="help-center-reading-title">开始前，先了解。</h2>
              <p>看清服务内容、照护记录与责任范围，再决定下一步。</p>
              <nav aria-label="相关说明">
                <a href="/care">照护服务与准备 →</a>
                <a href="/product">照护记录与产品体验 →</a>
                <a href="/trust">安全与责任范围 →</a>
              </nav>
            </section>
            <hr />
            <section
              id="contact"
              class="help-center__feedback"
              aria-labelledby="help-center-feedback-title"
            >
              <h2 id="help-center-feedback-title">问题还没有解决？</h2>
              <p>
                先保存问题发生的页面与时间，<br />以及相关记录。<br />了解反馈需要提供的信息。
              </p>
              <a href="/help/report-a-problem">查看反馈说明 →</a>
            </section>
          </aside>
        </div>
      </div>
    </section>
  </main>

  <script>
    const form = document.querySelector<HTMLFormElement>("[data-help-search-form]");
    const input = document.querySelector<HTMLInputElement>("[data-help-search]");
    const clear = document.querySelector<HTMLButtonElement>("[data-help-clear]");
    const status = document.querySelector<HTMLElement>("[data-help-status]");
    const empty = document.querySelector<HTMLElement>("[data-help-empty]");
    const list = document.querySelector<HTMLElement>("[data-help-list]");
    const categoryButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-help-category]"),
    );
    const items = Array.from(document.querySelectorAll<HTMLElement>("[data-help-item]"));
    let selectedCategory = "all";
    const normalize = (value: string) => value.trim().replace(/\s+/gu, " ").toLocaleLowerCase();

    const update = () => {
      const query = normalize(input?.value ?? "");
      const terms = query.split(" ").filter(Boolean);
      let visible = 0;

      items.forEach((item) => {
        const text = normalize(item.dataset.searchText ?? "");
        const matchesSearch = !query || terms.every((term) => text.includes(term));
        const matchesCategory =
          selectedCategory === "all" || item.dataset.helpTopic === selectedCategory;
        const visibleItem = matchesSearch && matchesCategory;

        item.hidden = !visibleItem;

        if (visibleItem) {
          visible += 1;
        }
      });

      categoryButtons.forEach((button) => {
        const active = button.dataset.helpCategory === selectedCategory;

        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });

      if (clear) {
        clear.hidden = !query;
      }

      if (empty) {
        empty.hidden = visible !== 0;
      }

      if (status) {
        status.textContent =
          query || selectedCategory !== "all"
            ? `找到 ${visible} 个相关问题`
            : `共 ${items.length} 个常见问题`;
      }
    };

    categoryButtons.forEach((button) =>
      button.addEventListener("click", () => {
        selectedCategory = button.dataset.helpCategory ?? "all";
        update();
      }),
    );
    input?.addEventListener("input", update);
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      update();
      list
        ?.querySelector<HTMLElement>(
          "[data-help-item]:not([hidden]) summary, [data-help-item]:not([hidden]) .help-center__question-link",
        )
        ?.focus();
    });
    clear?.addEventListener("click", () => {
      if (!input) {
        return;
      }

      input.value = "";
      selectedCategory = "all";
      update();
      input.focus();
    });
  </script>
</PublicPage>
