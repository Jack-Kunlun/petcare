---
import { helpArticles, helpCategories } from "../content/help";
import PublicPage from "./PublicPage.astro";
---

<PublicPage
  title="帮助中心 | PetCare 宠伴"
  description="查找 PetCare 发布需求、照护过程、账号、费用和照护者参与相关帮助。"
>
  <main id="main-content" class="help-center help-center--task">
    <section class="help-center__task-intro" aria-labelledby="help-center-title">
      <div class="content-container">
        <p class="eyebrow">帮助中心</p>
        <h1 id="help-center-title">产品体验指南</h1>
        <p class="help-center__intro-copy">从认识宠物，到安排照护，找到你关心的那一步。</p>
        <form class="help-center__search" role="search" data-help-search-form>
          <label class="sr-only" for="help-search">搜索帮助内容</label>
          <input
            id="help-search"
            name="q"
            type="search"
            autocomplete="off"
            placeholder="搜索你关心的问题"
            data-help-search
          />
          <button type="button" data-help-clear hidden>清空</button>
          <span class="help-center__search-icon" aria-hidden="true"></span>
        </form>
        <p class="help-center__status sr-only" aria-live="polite" data-help-status>
          共 {helpArticles.length} 个常见问题
        </p>
        <nav class="help-center__categories" aria-label="帮助分类" data-help-category-nav>
          <button type="button" class="is-active" aria-pressed="true" data-help-category="all">
            全部问题
          </button>
          {
            helpCategories.map((category) => (
              <button type="button" aria-pressed="false" data-help-category={category.id}>
                {category.label}
              </button>
            ))
          }
        </nav>
        <label class="sr-only" for="help-category">选择帮助分类</label>
        <select id="help-category" data-help-category-select hidden>
          <option value="all">全部问题</option>
          {helpCategories.map((category) => <option value={category.id}>{category.label}</option>)}
        </select>
      </div>
    </section>

    <section class="help-center__task-body" aria-labelledby="help-center-faq-title">
      <div class="content-container">
        <h2 class="eyebrow" id="help-center-faq-title">常见问题</h2>
        <div class="help-center__faq-list help-center__faq-list--task" data-help-list>
          {
            helpArticles.map((article) => (
              <article
                data-help-item
                data-help-article-category={article.category}
                data-search-text={`${article.title} ${article.summary} ${article.keywords} ${article.answer}`}
              >
                <details>
                  <summary>
                    <span>{article.title}</span>
                  </summary>
                  <p>{article.summary}</p>
                  <a class="text-link" href={`/help/${article.slug}`}>
                    查看完整说明 <span class="icon-arrow" aria-hidden="true" />
                  </a>
                </details>
              </article>
            ))
          }
        </div>
        <div class="help-center__empty" data-help-empty hidden>
          <h3>没有找到相关问题</h3>
          <p>试试更短的关键词，或先查看照护服务和小程序入口。</p>
          <div class="help-center__empty-links">
            <a class="text-link" href="/care">
              查看照护服务 <span class="icon-arrow" aria-hidden="true"></span>
            </a>
            <a class="text-link" href="/start">
              使用小程序 <span class="icon-arrow" aria-hidden="true"></span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="help-center__support help-center__support--task">
      <div class="content-container">
        <h2>还想了解其他内容？</h2>
        <p>查看全部指南，或先了解产品体验。</p>
        <a class="text-link" href="/product">
          查看产品预览 <span class="icon-arrow" aria-hidden="true"></span>
        </a>
      </div>
    </section>
  </main>

  <script>
    const form = document.querySelector<HTMLFormElement>("[data-help-search-form]");
    const input = document.querySelector<HTMLInputElement>("[data-help-search]");
    const clear = document.querySelector<HTMLButtonElement>("[data-help-clear]");
    const status = document.querySelector<HTMLElement>("[data-help-status]");
    const empty = document.querySelector<HTMLElement>("[data-help-empty]");
    const select = document.querySelector<HTMLSelectElement>("[data-help-category-select]");
    const categoryButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-help-category]"),
    );
    const items = Array.from(document.querySelectorAll<HTMLElement>("[data-help-item]"));
    const normalize = (value: string) => value.trim().replace(/\s+/gu, " ").toLocaleLowerCase();

    const update = () => {
      const query = normalize(input?.value ?? "");
      const terms = query.split(" ").filter(Boolean);
      const category = select?.value ?? "all";
      let visible = 0;

      items.forEach((item) => {
        const text = normalize(item.dataset.searchText ?? "");
        const matchesSearch = !query || terms.every((term) => text.includes(term));
        const matchesCategory = category === "all" || item.dataset.helpArticleCategory === category;
        const visibleItem = matchesSearch && matchesCategory;

        item.hidden = !visibleItem;

        if (visibleItem) {
          visible += 1;
        }
      });

      categoryButtons.forEach((button) => {
        const active = button.dataset.helpCategory === category;

        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });

      if (clear) {
        clear.hidden = !query;
      }

      if (empty) {
        empty.hidden = visible !== 0;
      }

      if (status) {
        status.textContent =
          query || category !== "all"
            ? `找到 ${visible} 个相关问题`
            : `共 ${items.length} 个常见问题`;
      }
    };

    categoryButtons.forEach((button) =>
      button.addEventListener("click", () => {
        if (!select) {
          return;
        }

        select.value = button.dataset.helpCategory ?? "all";
        update();
      }),
    );
    select?.addEventListener("change", update);
    input?.addEventListener("input", update);
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      update();
      document.querySelector<HTMLElement>("[data-help-item]:not([hidden]) summary")?.focus();
    });
    clear?.addEventListener("click", () => {
      if (!input) {
        return;
      }

      input.value = "";

      if (select) {
        select.value = "all";
      }

      update();
      input.focus();
    });
  </script>
</PublicPage>
