---
import type { WebsitePublicMediaAsset } from "@petcare/shared-types";
import { getPublicImage, getSafeWebsiteHref, hasPublicImage } from "./sections/safe-rendering";
import type { WebsitePublicHomeExperienceSection } from "./sections/public-section-types";

interface Props {
  /** CMS-managed homepage experience section, when present in the published snapshot. */
  section?: WebsitePublicHomeExperienceSection;
}

const { section } = Astro.props;
const content = section?.content;

// ponytail: keep one legacy fallback until every published home snapshot has home_experience.

const bundledImage = (src: string, alt: string, width = 512, height = 512) => ({
  src,
  width,
  height,
  alt,
});

const staticServices = [
  {
    number: "01",
    title: "宠物档案",
    description: "维护本人宠物的基础资料、日常备注与照片，让信息持续可查。",
    image: bundledImage("/brand/pet-life-feeding.jpg", "猫咪的日常档案照片"),
  },
  {
    number: "02",
    title: "萌宠课堂",
    description: "阅读已经发布的养宠文章，并通过分类与搜索找到需要的内容。",
    image: bundledImage("/brand/pet-life-grooming.jpg", "主人为猫咪梳理毛发"),
  },
  {
    number: "03",
    title: "受控社区",
    description: "发布真实养宠日常，浏览审核通过的动态并参与受控互动。",
    image: bundledImage("/brand/pet-life-playing.jpg", "两只狗在户外轻松玩耍"),
  },
];

const staticServiceJourney = [
  { itemKey: "account", title: "登录账户", description: "建立本地会话并维护个人资料" },
  { itemKey: "pet", title: "记录宠物", description: "创建档案并管理本人宠物照片" },
  { itemKey: "classroom", title: "浏览课堂", description: "按分类或关键词阅读已发布文章" },
  { itemKey: "community", title: "分享日常", description: "提交文字或图片动态等待审核" },
  { itemKey: "interaction", title: "参与互动", description: "使用点赞、评论、举报与站内通知" },
];

const staticSopRecords = [
  { itemKey: "basics", time: "01", label: "基本资料", state: "complete" as const },
  { itemKey: "habits", time: "02", label: "日常习惯", state: "complete" as const },
  { itemKey: "health", time: "03", label: "健康备注", state: "complete" as const },
  { itemKey: "photos", time: "04", label: "照片管理", state: "current" as const },
  { itemKey: "save", time: "05", label: "确认保存", state: "pending" as const },
];

const staticTrustDetails = [
  {
    itemKey: "scope",
    title: "个人版边界",
    description: "只呈现账户、宠物档案、课堂与受控社区等当前能力。",
  },
  {
    itemKey: "ownership",
    title: "本人数据",
    description: "宠物档案和受管理图片由当前账户维护，并校验所有权。",
  },
  {
    itemKey: "governance",
    title: "内容治理",
    description: "社区动态经过审核，并提供举报、下架和互动边界。",
  },
  {
    itemKey: "local",
    title: "本地验收",
    description: "当前版本用于本地开发与演示，所有能力以可运行链路为准。",
  },
];

const staticCommunityStories = [
  {
    itemKey: "daily_life",
    label: "宠物日常",
    category: "宠物日常",
    title: "那些让普通一天变得柔软的小事",
    description: "",
    image: bundledImage("/brand/pet-life-resting.jpg", "小狗安静地躺在沙发上休息"),
  },
  {
    itemKey: "care_guide",
    label: "养宠经验",
    category: "养宠经验",
    title: "从状态观察开始，读懂它今天的需要",
    description: "",
    image: bundledImage("/brand/pet-life-grooming.jpg", "主人在家中为猫咪梳理毛发"),
  },
  {
    itemKey: "companionship",
    label: "陪伴故事",
    category: "陪伴故事",
    title: "认真相处，让每一段日常都值得记录",
    description: "",
    image: bundledImage("/brand/pet-life-playing.jpg", "两只狗在户外自在互动"),
  },
];

const staticRecordImages = [
  bundledImage("/brand/pet-life-feeding.jpg", "猫咪宠物档案照片"),
  bundledImage("/brand/pet-life-grooming.jpg", "猫咪日常状态照片"),
];

const staticEvidence = [
  { itemKey: "owned", title: "本人维护", description: "跨账户访问会被拒绝" },
  { itemKey: "editable", title: "持续更新", description: "资料、备注与照片可以维护" },
  { itemKey: "protected", title: "关联保护", description: "受保护记录存在时拒绝误删" },
];

const staticBrand = {
  eyebrow: "记录每一次陪伴",
  title: "因为它是家人，所以每一段日常都值得被认真记录。",
  description: "PetCare 个人版把宠物档案、养宠内容和受控社区放在一个可本地验收的原型里。",
  image: bundledImage(
    "/brand/hero-community-companion-desktop-v1.webp",
    "猫和狗在自然光下安心相伴",
    1920,
    720,
  ),
};

type HomeImageReference = {
  asset: WebsitePublicMediaAsset | null;
  altText: string;
};

const resolveHomeImage = (
  reference: HomeImageReference,
  bundled: ReturnType<typeof bundledImage>,
) => {
  const resolved = getPublicImage(reference.asset, "placeholder");

  return {
    ...(hasPublicImage(reference.asset) ? resolved : bundled),
    alt: reference.altText,
  };
};

const services = content
  ? content.services.items.map((item, index) => {
      const image = resolveHomeImage(
        item.image,
        staticServices[index]?.image ??
          bundledImage("/brand/pet-life-feeding.jpg", item.image.altText),
      );

      return {
        number: item.label,
        title: item.title,
        description: item.description,
        image,
      };
    })
  : staticServices;

const serviceJourney = content?.journey.items ?? staticServiceJourney;
const sopRecords = content?.record.steps ?? staticSopRecords;
const trustDetails = content?.trust.items ?? staticTrustDetails;
const communityStories = content
  ? content.community.items.map((item, index) => {
      const image = resolveHomeImage(
        item.image,
        staticCommunityStories[index]?.image ??
          bundledImage("/brand/pet-life-playing.jpg", item.image.altText),
      );

      return {
        itemKey: item.itemKey,
        category: item.label,
        title: item.title,
        description: item.description,
        image,
      };
    })
  : staticCommunityStories;

const record = content
  ? {
      ...content.record,
      images: content.record.images.map((image, index) => {
        return resolveHomeImage(
          image,
          staticRecordImages[index] ?? staticRecordImages[index % staticRecordImages.length],
        );
      }),
    }
  : {
      eyebrow: "宠物档案示例",
      title: "把重要资料整理在一个地方",
      description:
        "从基本信息、日常习惯到照片管理，PetCare 让本人宠物资料保持清楚，并在删除时保护仍有关联的记录。",
      action: { label: "了解当前范围", href: "/about" },
      demoTitle: "宠物档案示例",
      statusLabel: "资料维护中",
      steps: staticSopRecords,
      images: staticRecordImages,
      extraImageCount: 3,
      evidence: staticEvidence,
    };

const brand = content
  ? {
      ...content.brand,
      image: resolveHomeImage(content.brand.image, staticBrand.image),
    }
  : staticBrand;

const servicesAction =
  content?.services.action ?? (content ? null : { label: "阅读萌宠课堂", href: "/articles" });
const journeyAction = content?.journey.action ?? null;
const recordAction =
  content?.record.action ?? (content ? null : { label: "了解当前范围", href: "/about" });
const trustAction =
  content?.trust.action ?? (content ? null : { label: "查看个人版说明", href: "/about" });
const communityAction =
  content?.community.action ?? (content ? null : { label: "阅读宠物课堂", href: "/articles" });

const servicesHref = servicesAction ? getSafeWebsiteHref(servicesAction.href) : null;
const journeyHref = journeyAction ? getSafeWebsiteHref(journeyAction.href) : null;
const recordHref = recordAction ? getSafeWebsiteHref(recordAction.href) : null;
const trustHref = trustAction ? getSafeWebsiteHref(trustAction.href) : null;
const communityHref = communityAction ? getSafeWebsiteHref(communityAction.href) : null;
---

<section class="home-services" aria-labelledby="home-services-title">
  <div class="content-container">
    <header class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">{content?.services.eyebrow ?? "当前个人版能力"}</p>
        <h2 id="home-services-title">{content?.services.title ?? "从宠物档案，到真实养宠内容"}</h2>
      </div>
      <div>
        <p>
          {
            content?.services.description ??
              "PetCare 当前提供本人宠物档案、萌宠课堂与受控社区，并明确保持个人、本地原型边界。"
          }
        </p>
        {
          servicesHref && servicesAction ? (
            <a class="text-link" href={servicesHref}>
              {servicesAction.label} <span aria-hidden="true">→</span>
            </a>
          ) : null
        }
      </div>
    </header>
    <div class="home-services__grid">
      {
        services.map((service) => (
          <article class="service-story">
            <img
              src={service.image.src}
              width={service.image.width}
              height={service.image.height}
              alt={service.image.alt}
              loading="lazy"
            />
            <div class="service-story__copy">
              <span aria-hidden="true">{service.number}</span>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="service-journey-section" aria-labelledby="service-journey-title">
  <div class="content-container">
    <header class="section-heading">
      <p class="eyebrow">{content?.journey.eyebrow ?? "当前使用路径"}</p>
      <h2 id="service-journey-title">{content?.journey.title ?? "每一步都有真实页面和状态"}</h2>
      <p>
        {
          content?.journey.description ??
            "从账户与宠物档案，到课堂、社区和互动通知，当前能力都由真实数据与明确状态支撑。"
        }
      </p>
      {
        journeyHref && journeyAction ? (
          <a class="text-link" href={journeyHref}>
            {journeyAction.label} <span aria-hidden="true">→</span>
          </a>
        ) : null
      }
    </header>
    <ol class="service-journey">
      {
        serviceJourney.map((item, index) => (
          <li>
            <span class="service-journey__number">{String(index + 1).padStart(2, "0")}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="service-record-section" aria-labelledby="service-record-title">
  <div class="content-container service-record-section__inner">
    <figure class="service-record-demo" aria-labelledby="service-record-demo-title">
      <div class="service-record-demo__topbar">
        <img src="/brand/petcare-symbol-color.svg" width="28" height="28" alt="" />
        <div>
          <p id="service-record-demo-title">{record.demoTitle}</p>
          <span>{record.statusLabel}</span>
        </div>
        <span class="service-record-demo__progress">
          {
            record.steps.filter((step) => step.state === "complete" || step.state === "current")
              .length
          } / {record.steps.length}
        </span>
      </div>
      <ol class="service-record-demo__timeline">
        {
          sopRecords.map((step) => (
            <li
              class:list={[
                step.state === "complete" && "is-complete",
                step.state === "current" && "is-current",
              ]}
            >
              <span class="service-record-demo__dot" aria-hidden="true" />
              <time>{step.time}</time>
              <strong>{step.label}</strong>
              <span>{step.state === "pending" ? "待完成" : "已记录"}</span>
            </li>
          ))
        }
      </ol>
      <div class="service-record-demo__media" aria-label="已上传的宠物照片">
        {
          record.images.map((image) => (
            <img
              src={image.src}
              width={image.width}
              height={image.height}
              alt={image.alt}
              loading="lazy"
            />
          ))
        }
        {
          record.extraImageCount > 0 ? (
            <div aria-hidden="true">+{record.extraImageCount}</div>
          ) : null
        }
      </div>
    </figure>
    <div class="service-record-section__copy">
      <p class="eyebrow">{record.eyebrow}</p>
      <h2 id="service-record-title">{record.title}</h2>
      <p class="section-description">{record.description}</p>
      <ul class="evidence-list">
        {
          record.evidence.map((item) => (
            <li>
              <strong>{item.title}</strong>
              <span>{item.description}</span>
            </li>
          ))
        }
      </ul>
      {
        recordHref && recordAction ? (
          <a class="text-link" href={recordHref}>
            {recordAction.label} <span aria-hidden="true">→</span>
          </a>
        ) : null
      }
    </div>
  </div>
</section>

<section class="safety-section" aria-labelledby="safety-title">
  <div class="content-container safety-section__inner">
    <header class="section-heading">
      <p class="eyebrow">{content?.trust.eyebrow ?? "范围与数据边界"}</p>
      <h2 id="safety-title">{content?.trust.title ?? "只陈述当前已经具备的能力"}</h2>
      <p>
        {
          content?.trust.description ??
            "当前只呈现账户、宠物档案、内容阅读和受控互动，并让权限与状态边界保持可验证。"
        }
      </p>
      {
        trustHref && trustAction ? (
          <a class="text-link" href={trustHref}>
            {trustAction.label} <span aria-hidden="true">→</span>
          </a>
        ) : null
      }
    </header>
    <ol class="safety-details">
      {
        trustDetails.map((item, index) => (
          <li>
            <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="community-preview" aria-labelledby="community-preview-title">
  <div class="content-container">
    <header class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">{content?.community.eyebrow ?? "宠物生活"}</p>
        <h2 id="community-preview-title">
          {content?.community.title ?? "记录真实日常，也分享可靠的养宠内容"}
        </h2>
      </div>
      <div>
        <p>
          {
            content?.community.description ??
              "从日常相处到养宠经验，已发布的课堂文章与审核通过的社区动态共同组成当前内容空间。"
          }
        </p>
        {
          communityHref && communityAction ? (
            <a class="text-link" href={communityHref}>
              {communityAction.label} <span aria-hidden="true">→</span>
            </a>
          ) : null
        }
      </div>
    </header>
    <div class="community-preview__grid">
      {
        communityStories.map((story) => (
          <article class="community-story">
            <img
              src={story.image.src}
              width={story.image.width}
              height={story.image.height}
              alt={story.image.alt}
              loading="lazy"
            />
            <p>{story.category}</p>
            <h3>{story.title}</h3>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="brand-story-section" aria-labelledby="brand-story-title">
  <img
    class="brand-story-section__image"
    src={brand.image.src}
    width={brand.image.width}
    height={brand.image.height}
    alt={brand.image.alt}
    loading="lazy"
  />
  <div class="content-container brand-story-section__inner">
    <div>
      <p class="eyebrow">{brand.eyebrow}</p>
      <h2 id="brand-story-title">{brand.title}</h2>
      <p>{brand.description}</p>
    </div>
  </div>
</section>
