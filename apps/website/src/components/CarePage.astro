---
import PublicPage from "./PublicPage.astro";
import CarePreview from "./CarePreview.astro";

const careTypes = [
  {
    title: "上门喂养",
    description: "按约定补充食物与饮水，整理相关生活环境，并留下照护记录。",
  },
  {
    title: "遛狗",
    description: "确认时段、牵引习惯与路线，完成散步并记录当天的情况。",
  },
  {
    title: "陪玩",
    description: "在熟悉的环境里互动，留意宠物状态，尊重相处与玩耍边界。",
  },
];

const handoverItems = [
  ["生活习惯", "饮食、行为、喜欢的互动与照护提醒。"],
  ["用品与进出", "用品位置、进出方式与需要留意的门窗。"],
  ["时间与范围", "服务时间、地点、内容与双方责任。"],
  ["记录与异常", "约定记录方式，保留沟通，了解反馈路径。"],
];

const careStages = ["发布需求", "沟通确认", "跟进照护", "完成反馈"];
---

<PublicPage
  overlayHeader
  title="照护服务 | PetCare 宠伴"
  description="了解上门喂养、遛狗与陪玩等照护场景，以及安排前的沟通与交接事项。"
>
  <main id="main-content" class="interior-page interior-page--care care-page">
    <section class="interior-page__hero care-page__hero" aria-labelledby="care-title">
      <div class="interior-page__hero-scene">
        <img src="/brand/home/walk.png" alt="" aria-hidden="true" fetchpriority="high" />
      </div>
      <div class="interior-page__hero-wash" aria-hidden="true"></div>
      <div class="interior-page__hero-inner content-container">
        <div class="interior-page__hero-copy">
          <p class="interior-page__eyebrow">照护服务 · 产品体验</p>
          <h1 id="care-title">熟悉的日常，<br /><span>认真</span>照顾。</h1>
          <p class="interior-page__hero-description">
            暂时离家、日常散步或互动陪伴，先说清它的习惯与需要，再确认这次的安排。
          </p>
          <a class="interior-page__button" href="#care-types">了解照护方式</a>
        </div>
      </div>
      <img
        class="interior-page__hero-wave"
        src="/brand/interior/care-wave.svg"
        alt=""
        aria-hidden="true"
      />
    </section>

    <section
      id="care-types"
      class="interior-page__section content-container care-page__daily"
      aria-labelledby="care-types-title"
    >
      <figure class="interior-page__photo care-page__home-photo">
        <img src="/brand/home/care-record.png" alt="照护者在家中陪伴金毛犬" loading="lazy" />
        <figcaption>照护发生在熟悉的生活里。</figcaption>
      </figure>
      <div class="care-page__type-copy">
        <h2 id="care-types-title">照顾的，是具体的小事。</h2>
        <div class="care-page__type-list">
          {
            careTypes.map((type) => (
              <article>
                <h3>{type.title}</h3>
                <p>{type.description}</p>
              </article>
            ))
          }
        </div>
        <p class="interior-page__fine-print">
          可服务区域、时间与具体范围，须在确认本次方案时核对。页面内容不代表服务已向所有地区开放。
        </p>
      </div>
    </section>

    <section
      class="interior-page__section content-container care-page__agreement"
      aria-labelledby="care-agreement-title"
    >
      <div class="care-page__agreement-copy">
        <h2 id="care-agreement-title">先把安排谈清楚。</h2>
        <article>
          <h3>按需求协商</h3>
          <p>说明预算与需要，围绕内容、时间和照护事项确认本次安排。</p>
        </article>
        <article>
          <h3>按方案了解</h3>
          <p>查看方案包含的内容与费用，核对服务范围和取消条件。</p>
        </article>
        <a class="interior-page__text-link" href="/payments">查看支付、结算与退款说明 →</a>
      </div>
      <div class="interior-page__handover-card">
        <p class="interior-page__card-label">交接备忘</p>
        {
          handoverItems.map(([title, description]) => (
            <article>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))
        }
      </div>
      <p class="interior-page__sample-note">
        页面展示照护沟通与交接产品界面；具体服务入口、支付及结算能力以平台当前实际开放状态为准。
      </p>
    </section>

    <section
      class="interior-page__section content-container care-page__records"
      aria-labelledby="care-records-title"
    >
      <div class="care-page__records-copy">
        <h2 id="care-records-title">每一步，留下记录。</h2>
        <p class="interior-page__stage-line">{careStages.join(" → ")}</p>
        <p>照护手记把完成状态、照片和备注放在一起，让一次照护从安排走向回看。</p>
        <a class="interior-page__text-link" href="/trust">了解安全与保障 →</a>
      </div>
      <div class="care-page__record-showcase">
        <figure class="interior-page__photo care-page__cat-photo">
          <img src="/brand/home/home.png" alt="猫咪在家中陪着主人记录生活" loading="lazy" />
        </figure>
        <div class="care-page__phone">
          <CarePreview initialStep={2} id="service-care" class="care-page__phone-card" />
        </div>
      </div>
    </section>

    <section class="interior-page__closing content-container care-page__closing">
      <div>
        <h2>从了解它的日常，开始安排照护。</h2>
        <a class="interior-page__button" href="/trust">了解安全与保障</a>
      </div>
    </section>
  </main>
</PublicPage>
