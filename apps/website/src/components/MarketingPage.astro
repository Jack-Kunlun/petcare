---
import type { MarketingPage as MarketingPageContent } from "../content/marketing";
import CarePreview from "./CarePreview.astro";
import MotionEnhancer from "./MotionEnhancer.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import { getWebsiteRuntimeConfig } from "../lib/runtime-config";
import "../styles/global.css";
import "../styles/home-shell.css";
import "../styles/interior.css";
import "../styles/reading-pages.css";

interface Props {
  page: MarketingPageContent;
  emptyMessage?: string;
}

const { page, emptyMessage } = Astro.props;
const publicUrl = getWebsiteRuntimeConfig().publicUrl;
const heroImage =
  page.heroImage ??
  (page.layout
    ? null
    : {
        src: "/brand/hero-community-companion-desktop-v1.webp",
        alt: "猫和狗在自然光下安心相伴",
      });
const layout = page.layout ?? "marketing";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={page.description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, publicUrl)} />
    <link rel="icon" href="/brand/petcare-favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#edf6ff" />
    <title>{page.title}</title>
  </head>
  <body
    class:list={[
      "interior-site",
      `interior-site--${layout}`,
      (page.layout === "stories" || page.layout === "safety") && "interior-site--visual",
    ]}
  >
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <SiteHeader static />
    <main id="main-content" class:list={["marketing-page", `marketing-page--${layout}`]}>
      <section
        class="marketing-page__hero"
        data-parallax={heroImage ? true : undefined}
        aria-labelledby="marketing-page-title"
      >
        {
          heroImage ? (
            <img
              class="marketing-page__hero-image"
              src={heroImage.src}
              alt={heroImage.alt}
              fetchpriority="high"
            />
          ) : null
        }
        {heroImage ? <div class="marketing-page__hero-overlay" /> : null}
        <div class="marketing-page__hero-inner content-container">
          <div class="marketing-page__hero-copy">
            <p class="eyebrow">{page.eyebrow}</p>
            <h1 id="marketing-page-title">
              {
                layout === "stories" ? (
                  <>
                    <span class="marketing-page__hero-accent">陪伴</span>，发生在
                    <br />
                    每个寻常的瞬间。
                  </>
                ) : layout === "safety" ? (
                  <>
                    信任，来自
                    <>
                      <br />
                      <span class="marketing-page__hero-accent">看得见</span>
                    </>
                    的过程。
                  </>
                ) : (
                  page.heroTitle
                )
              }
            </h1>
            <p>{page.heroDescription}</p>
            {
              page.heroActions?.length ? (
                <div class="section-actions">
                  {page.heroActions.map((action) => (
                    <a
                      class:list={["button", action.secondary && "button--secondary"]}
                      href={action.href}
                    >
                      {action.label} <span class="icon-arrow" aria-hidden="true" />
                    </a>
                  ))}
                </div>
              ) : null
            }
          </div>
        </div>
      </section>

      {
        page.sections.map((section) => (
          <section
            id={section.id}
            class:list={[
              "marketing-page__section",
              `marketing-page__section--${section.tone ?? "white"}`,
              `marketing-page__section--${section.kind}`,
            ]}
            aria-labelledby={`${section.id}-title`}
          >
            <div class="content-container">
              {layout !== "safety" && !(layout === "stories" && section.kind === "cards") ? (
                <header class="marketing-page__section-heading" data-scroll-reveal>
                  <p class="eyebrow">{section.eyebrow}</p>
                  {section.kind === "timeline" && section.roleLabel ? (
                    <span
                      class:list={[
                        "marketing-page__role-label",
                        `marketing-page__role-label--${section.roleLabel === "照护者" ? "provider" : "owner"}`,
                      ]}
                      id={`${section.id}-title`}
                    >
                      {section.roleLabel}
                    </span>
                  ) : null}
                  {!(layout === "payments" && section.kind === "timeline" && section.roleLabel) ? (
                    <h2 id={`${section.id}-title`}>{section.title}</h2>
                  ) : null}
                  {section.description ? <p>{section.description}</p> : null}
                </header>
              ) : null}
              {layout === "stories" && section.kind === "cards" ? (
                <h2 class="sr-only" id={`${section.id}-title`}>
                  {section.title}
                </h2>
              ) : null}

              {section.kind === "cards" ? (
                <div class:list={["marketing-page__cards", `marketing-page__cards--${layout}`]}>
                  {section.items.map((item, index) => (
                    <article
                      class="marketing-page__card"
                      data-scroll-reveal
                      style={`--reveal-delay: ${Math.min(index, 5) * 45}ms`}
                    >
                      {item.image ? (
                        <img src={item.image.src} alt={item.image.alt} loading="lazy" />
                      ) : null}
                      <div class="marketing-page__card-copy">
                        {item.label ? (
                          <span class="marketing-page__card-label">{item.label}</span>
                        ) : null}
                        <h3>{item.title}</h3>
                        <p>{item.description}</p>
                      </div>
                      {item.href ? (
                        <a class="text-link" href={item.href}>
                          了解更多 <span class="icon-arrow" aria-hidden="true" />
                        </a>
                      ) : null}
                    </article>
                  ))}
                </div>
              ) : null}
              {layout === "support" && section.kind === "cards" && page.cta ? (
                <div class="marketing-page__inline-cta">
                  <a class="button" href={page.cta.href}>
                    {page.cta.label} <span class="icon-arrow" aria-hidden="true" />
                  </a>
                </div>
              ) : null}

              {section.kind === "split" ? (
                <div class="marketing-page__split" data-scroll-reveal>
                  <div class="marketing-page__split-copy">
                    <h3>{section.title}</h3>
                    <p>{section.description}</p>
                    {section.action ? (
                      <a class="button" href={section.action.href}>
                        {section.action.label} <span class="icon-arrow" aria-hidden="true" />
                      </a>
                    ) : null}
                  </div>
                  <img src={section.image.src} alt={section.image.alt} loading="lazy" />
                </div>
              ) : null}

              {section.kind === "timeline" ? (
                <div
                  class:list={[
                    "marketing-page__timeline-layout",
                    layout === "safety" && "marketing-page__timeline-layout--safety",
                  ]}
                >
                  {layout === "safety" ? (
                    <div class="reading-safety-evidence">
                      <h2 id={`${section.id}-title`}>{section.title}</h2>
                      <div class="reading-safety-mechanisms">
                        {section.items.map((item) => (
                          <div>
                            <h3>{item.title}</h3>
                            <p>{item.description}</p>
                          </div>
                        ))}
                      </div>
                      <a class="text-link" href="/payments">
                        查看费用与规则 →
                      </a>
                    </div>
                  ) : (
                    <ol class="marketing-page__timeline">
                      {section.items.map((item, index) => (
                        <li
                          data-scroll-reveal
                          style={`--reveal-delay: ${Math.min(index, 6) * 45}ms`}
                        >
                          <span>{String(index + 1).padStart(2, "0")}</span>
                          <div>
                            <h3>{item.title}</h3>
                            <p>{item.description}</p>
                          </div>
                        </li>
                      ))}
                    </ol>
                  )}
                  {layout === "safety" ? (
                    <figure class="reading-safety-preview">
                      <CarePreview initialStep={2} id="safety-care" />
                    </figure>
                  ) : null}
                </div>
              ) : null}

              {section.kind === "note" ? (
                layout === "safety" ? (
                  <div class="reading-safety-responsibility">
                    <h2 id={`${section.id}-title`}>{section.title}</h2>
                    <p>{section.description}</p>
                    <a class="text-link" href="/platform-rules">
                      阅读平台规则 →
                    </a>
                    <a class="text-link" href="/privacy">
                      了解隐私保护 →
                    </a>
                    <a class="text-link" href="/help">
                      遇到问题，查看帮助与反馈 →
                    </a>
                  </div>
                ) : (
                  <aside class="marketing-page__note" data-scroll-reveal>
                    <strong>{section.title}</strong>
                    <p>{section.description}</p>
                    {layout === "support" && page.cta ? (
                      <>
                        <p>你可以继续阅读使用指南、服务规则与隐私说明。</p>
                        <a class="text-link" href={page.cta.href}>
                          查看帮助指南 <span class="icon-arrow" aria-hidden="true" />
                        </a>
                      </>
                    ) : null}
                  </aside>
                )
              ) : null}
            </div>
          </section>
        ))
      }

      {
        layout === "classroom" ? (
          <section class="reading-classroom-empty" aria-labelledby="classroom-empty-title">
            <div class="content-container">
              <p class="eyebrow">内容状态</p>
              <h2 id="classroom-empty-title">{emptyMessage ?? "目前还没有已发布的文章。"}</h2>
              <p>你可以先查看帮助指南，了解当前产品的使用方式。</p>
              <a class="button" href="/help">
                查看帮助指南 <span class="icon-arrow" aria-hidden="true" />
              </a>
            </div>
          </section>
        ) : null
      }

      {
        page.cta && layout !== "support" && layout !== "safety" ? (
          <section
            class="marketing-page__cta"
            data-scroll-reveal
            aria-labelledby="marketing-page-cta-title"
          >
            <div class="content-container">
              {page.cta.eyebrow ? <p class="eyebrow">{page.cta.eyebrow}</p> : null}
              {page.cta.title ? <h2 id="marketing-page-cta-title">{page.cta.title}</h2> : null}
              {page.cta.description ? <p>{page.cta.description}</p> : null}
              <a class={layout === "payments" ? "text-link" : "button"} href={page.cta.href}>
                {page.cta.label} <span class="icon-arrow" aria-hidden="true" />
              </a>
            </div>
          </section>
        ) : null
      }
    </main>
    <SiteFooter static />
    <MotionEnhancer />
  </body>
</html>
