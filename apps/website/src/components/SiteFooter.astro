---
import { getSafeWebsiteHref } from "./sections/safe-rendering";
import type { WebsitePublicSiteFooterSection } from "./sections/public-section-types";

interface Props {
  /** Validated public site-footer section. */
  section?: WebsitePublicSiteFooterSection;
  /** Uses the code-owned public website footer instead of managed shell content. */
  static?: boolean;
  /** Uses the homepage footer design and navigation. */
  home?: boolean;
}

const { section, static: useStatic = false, home = false } = Astro.props;
const designShell = home || useStatic;
const groups = section?.content.groups ?? [];
const description = section?.content.description ?? "";
const copyright = designShell
  ? "© 2026 PetCare · 陪伴每一次托付"
  : (section?.content.copyright ?? "");
const showLogo = section?.settings.showLogo === true;
const homeLinks = [
  { label: "照护服务", href: "/care" },
  { label: "帮助中心", href: "/help" },
  { label: "联系与反馈", href: "/contact" },
  { label: "服务协议", href: "/terms" },
  { label: "隐私政策", href: "/privacy" },
  { label: "平台规则", href: "/platform-rules" },
];
---

<footer class:list={["site-footer", designShell && "site-footer--home"]}>
  {
    designShell ? (
      <div class="site-footer__inner site-footer__inner--home">
        <a class="site-footer__brand" href="/" aria-label="PetCare 宠伴">
          <img src="/brand/home/symbol.svg" alt="" loading="lazy" />
          <strong>PetCare 宠伴</strong>
        </a>
        <nav class="site-footer__navigation" aria-label="页脚导航">
          <ul>
            {homeLinks.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    ) : (
      <div class="site-footer__inner">
        <section class="site-footer__brand" aria-label="PetCare">
          {showLogo ? (
            <img
              src="/brand/petcare-symbol-reverse.svg"
              width="40"
              height="40"
              alt=""
              loading="lazy"
            />
          ) : null}
          <strong>PetCare 宠伴</strong>
          <p>{description}</p>
        </section>
        {groups.map((group) => (
          <section aria-labelledby={`footer-${group.groupKey}`}>
            <h2 id={`footer-${group.groupKey}`}>{group.title}</h2>
            <ul>
              {group.links.map((item) => {
                const href = getSafeWebsiteHref(item.href);

                return href ? (
                  <li>
                    <a href={href}>{item.label}</a>
                  </li>
                ) : null;
              })}
            </ul>
          </section>
        ))}
      </div>
    )
  }
  <div class="site-footer__legal">
    <p class="site-footer__copyright">{copyright}</p>
    <p class="site-footer__icp">
      <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer"
        >赣ICP备2025073600号-2</a
      >
      <a
        href="https://beian.mps.gov.cn/#/query/webSearch?code=44010602016832"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img src="/brand/beian.png" width="14" height="14" alt="" loading="lazy" />
        粤公网安备44010602016832号
      </a>
    </p>
  </div>
</footer>
