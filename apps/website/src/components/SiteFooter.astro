---
import { getSafeWebsiteHref } from "./sections/safe-rendering";
import type { WebsitePublicSiteFooterSection } from "./sections/public-section-types";

interface Props {
  /** Validated public site-footer section. */
  section?: WebsitePublicSiteFooterSection;
  /** Uses the code-owned public website footer instead of managed shell content. */
  static?: boolean;
}

const { section, static: useStatic = false } = Astro.props;
const staticGroups = [
  {
    title: "产品能力",
    groupKey: "product",
    links: [
      { label: "产品能力", href: "/product" },
      { label: "宠物主人", href: "/for-pet-owners" },
      { label: "服务者", href: "/for-providers" },
      { label: "悬赏服务", href: "/rewards" },
      { label: "支付与结算", href: "/payments" },
    ],
  },
  {
    title: "了解 PetCare",
    groupKey: "learn",
    links: [
      { label: "关于我们", href: "/about" },
      { label: "联系我们", href: "/contact" },
      { label: "安全与保障", href: "/trust" },
      { label: "社区故事", href: "/stories" },
    ],
  },
  {
    title: "帮助与规则",
    groupKey: "help",
    links: [
      { label: "帮助中心", href: "/help" },
      { label: "宠物课堂", href: "/articles" },
      { label: "服务流程", href: "/service-flow" },
      { label: "服务协议", href: "/terms" },
      { label: "隐私政策", href: "/privacy" },
      { label: "退款规则", href: "/refund-policy" },
      { label: "平台规则", href: "/platform-rules" },
    ],
  },
];
const groups = useStatic ? staticGroups : (section?.content.groups ?? []);
const description = useStatic
  ? "让爱在生活里更好，记录每一次认真陪伴。"
  : (section?.content.description ?? "");
const copyright = useStatic ? "© 2024 PetCare. 保留所有权利。" : (section?.content.copyright ?? "");
const showLogo = useStatic || section?.settings.showLogo === true;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <section class="site-footer__brand" aria-label="PetCare">
      {
        showLogo ? (
          <img
            src="/brand/petcare-symbol-reverse.svg"
            width="40"
            height="40"
            alt=""
            loading="lazy"
          />
        ) : null
      }
      <strong>PetCare 宠伴</strong>
      <p>{description}</p>
    </section>
    {
      groups.map((group) => (
        <section aria-labelledby={`footer-${group.groupKey}`}>
          <h2 id={`footer-${group.groupKey}`}>{group.title}</h2>
          <ul>
            {group.links.map((item) => {
              const href = getSafeWebsiteHref(item.href);

              return href ? (
                <li>
                  <a href={href}>{item.label}</a>
                </li>
              ) : null;
            })}
          </ul>
        </section>
      ))
    }
  </div>
  <p class="site-footer__copyright">{copyright}</p>
  <p class="site-footer__icp">
    <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer"
      >赣ICP备2025073600号-2</a
    >
    <a
      href="https://beian.mps.gov.cn/#/query/webSearch?code=44010602016832"
      target="_blank"
      rel="noopener noreferrer"
    >
      <img src="/brand/beian.png" width="14" height="14" alt="" loading="lazy" />
      粤公网安备44010602016832号
    </a>
  </p>
</footer>
