{
  "name": "@petcare/miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "PetCare宠伴小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "TailwindCSS",
    "framework": "React"
  },
  "scripts": {
    "build": "pnpm build:weapp",
    "build:weapp": "taro build --type weapp && node ../../scripts/style-output-policy.mjs miniapp dist",
    "dev": "pnpm dev:weapp",
    "dev:weapp": "taro build --type weapp --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "taro build --type h5 --watch",
    "lint": "pnpm lint:styles && eslint .",
    "lint:styles": "node ../../scripts/style-policy.mjs miniapp",
    "lint:fix": "eslint . --fix",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "clean": "node ../../scripts/clean.mjs dist coverage .temp .turbo"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@petcare/shared-types": "workspace:*",
    "@petcare/shared-utils": "workspace:*",
    "@taroify/core": "0.9.2",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@petcare/eslint-config-base": "workspace:*",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@tarojs/cli": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "autoprefixer": "^10.5.4",
    "babel-loader": "^10.1.1",
    "eslint": "9.39.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^62.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-environment-node": "^30.4.1",
    "postcss": "^8.5.20",
    "react-refresh": "^0.18.0",
    "sass": "1.102.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "29.4.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.64.0",
    "weapp-tailwindcss": "5.2.4",
    "webpack": "5.91.0"
  }
}
