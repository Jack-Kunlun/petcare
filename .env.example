# PetCare 环境变量配置示例
# 复制此文件为根目录 `.env` 并填写本地值
# 示例值仅用于本地开发；生产环境必须由部署平台注入独立强密钥

# ===== 服务器配置 =====
PORT=3000
NODE_ENV=development

# ===== Docker 镜像标签 =====
# 本地留空：应用镜像使用 petcare/*，PostgreSQL/Redis/Nginx 使用 Docker Hub 官方镜像。
# 生产发布由部署环境写入完整私有 Registry。
IMAGE_REGISTRY=
SERVER_IMAGE_TAG=local
ADMIN_IMAGE_TAG=local
WEBSITE_IMAGE_TAG=local

# ===== 日志配置 =====
# 默认 info；仅本地 development + debug 会额外记录未脱敏请求正文，请仅短时排查使用
LOG_LEVEL=info
# 相对路径以 monorepo 根目录为基准
LOG_DIR=./logs/server

# ===== 数据库配置（独立配置项）=====
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=user
# ⚠️ 生产环境必须使用强密码！建议: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
DB_NAME=petcare
# 仅支持小写 PostgreSQL 标识符：以字母或下划线开头，只含小写字母、数字和下划线
DB_SCHEMA=public

# ===== Redis配置（独立配置项）=====
REDIS_HOST=localhost
REDIS_PORT=6379
# ⚠️ 生产环境必须设置强密码！建议: openssl rand -base64 24
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_REDIS_PASSWORD

# ===== 异步任务 / Worker 配置 =====
# 生产者和独立 Worker 必须使用相同的前缀；不同环境应使用不同前缀。
QUEUE_PREFIX=petcare
# 单个 Worker 的并发任务数
WORKER_CONCURRENCY=5
# Transactional Outbox 的轮询间隔（毫秒）
OUTBOX_POLL_INTERVAL_MS=1000
# 悬赏订单超时关闭延迟（48 小时，单位：毫秒）
ORDER_TIMEOUT_DELAY_MS=172800000
# Cycle 5–7 商业服务总开关；资质与发布门禁完成前保持 false
COMMERCIAL_SERVICES_ENABLED=false

# ===== JWT配置 =====
# ⚠️ 生产环境必须使用至少32字符的强随机密钥！
# 生成方法: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_SECONDS=604800

# ===== 管理员认证初始化 =====
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD

# 仅限本地开发；生产环境必须留空并接入阿里云号码认证服务
SMS_DEV_CODE=246810
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
SMS_CODE_TTL_SECONDS=300
SMS_SEND_COOLDOWN_SECONDS=60
SMS_HOURLY_LIMIT=5
SMS_MAX_ATTEMPTS=5
CAPTCHA_TTL_SECONDS=300
CAPTCHA_MAX_ATTEMPTS=5
AUTH_PASSWORD_MAX_ATTEMPTS=5
AUTH_PASSWORD_WINDOW_SECONDS=900

# ===== 社区发布限流 =====
# 同一用户每小时最多提交 10 条动态
COMMUNITY_POST_MAX_ATTEMPTS=10
COMMUNITY_POST_WINDOW_SECONDS=3600
# 同一用户每分钟最多上传 5 张社区图片
COMMUNITY_MEDIA_MAX_ATTEMPTS=5
COMMUNITY_MEDIA_WINDOW_SECONDS=60

# ===== API配置 =====
API_BASE_URL=http://localhost:8986/api
# Miniapp 配置参考；实际本地覆盖写入 apps/miniapp/.env.development.local，根 .env 不会被 Miniapp Vite 加载
VITE_MINIAPP_API_BASE_URL=http://localhost:3000
# Miniapp 悬赏入口开关；须与 Server 开关及发布门禁同步
VITE_COMMERCIAL_SERVICES_ENABLED=false

# ===== CORS配置 =====
# CORS允许的源（逗号分隔）
ALLOWED_ORIGINS=http://localhost:8986,http://127.0.0.1:8986,http://localhost:5173,http://127.0.0.1:5173

# ===== 第三方服务（可选）=====
# 微信AppID
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 公开媒体存储：生产默认 disabled；docker-compose.local.yml 会固定使用 local
PUBLIC_MEDIA_STORAGE_PROVIDER=disabled
# local provider 的服务端目录；相对路径从仓库根目录解析
LOCAL_MEDIA_DIRECTORY=data/media
# 留空时使用 WEBSITE_PUBLIC_URL + /media
LOCAL_MEDIA_PUBLIC_BASE_URL=

# 腾讯云 COS（仅在 provider=tencent-cos 时使用）
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=
TENCENT_COS_PUBLIC_BASE_URL=

# ===== 官网内容运行时配置 =====
WEBSITE_PUBLIC_URL=http://localhost:8080
# 仅由 Astro SSR 在 Docker 内网读取，禁止使用 PUBLIC_ 前缀或暴露给浏览器。
WEBSITE_CONTENT_API_BASE_URL=http://server:3000
WEBSITE_PREVIEW_TTL_SECONDS=600
WEBSITE_CONTENT_CACHE_TTL_SECONDS=86400
WEBSITE_LAST_SUCCESS_TTL_SECONDS=300
# 官网独立 Nginx 网关映射到宿主机的端口。
WEBSITE_PORT=8080


# ===== 开发环境端口暴露配置 =====
# 仅由本地 Compose 覆盖使用；生产基础 Compose 不映射这些端口。
EXPOSE_DB_PORT=5432
EXPOSE_REDIS_PORT=6379
EXPOSE_SERVER_PORT=3300
EXPOSE_ADMIN_PORT=8986
