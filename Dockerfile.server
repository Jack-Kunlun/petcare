# ===== 多阶段构建：后端服务 =====
FROM node:24.19-alpine AS server-builder

WORKDIR /app

# 复制依赖文件
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
RUN corepack enable

COPY apps/server/package.json ./apps/server/
COPY packages/eslint-config-base/package.json ./packages/eslint-config-base/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/shared-utils/package.json ./packages/shared-utils/
COPY scripts/enforce-pnpm.mjs ./scripts/enforce-pnpm.mjs

# 安装依赖
RUN pnpm install --frozen-lockfile

# 仅复制后端构建所需的工作区源码，避免引入无关应用触发额外安装。
COPY apps/server ./apps/server
COPY packages/eslint-config-base ./packages/eslint-config-base
COPY packages/shared-types ./packages/shared-types
COPY packages/shared-utils ./packages/shared-utils

# 构建
RUN pnpm --filter @petcare/shared-types build
RUN pnpm --filter @petcare/server build
RUN pnpm --filter @petcare/server --prod deploy --legacy /app/server-production
RUN test -f /app/server-production/dist/main.js \
  && test -f /app/server-production/src/seed/seed-initial-data.ts \
  && test -f /app/server-production/node_modules/prisma/build/index.js \
  && test -f /app/server-production/node_modules/tsx/dist/cli.mjs \
  && test -f /app/server-production/node_modules/@petcare/shared-types/dist/index.js

# ===== 运行阶段 =====
FROM node:24.19-alpine AS server-runner

WORKDIR /app

# 复制构建产物和依赖
COPY --from=server-builder /app/pnpm-workspace.yaml ./
COPY --from=server-builder /app/pnpm-lock.yaml ./
COPY --from=server-builder /app/package.json ./
# 生产服务器无法访问 npm，构建镜像时预热仓库锁定的 pnpm。
RUN corepack enable && pnpm --version

COPY --from=server-builder /app/server-production ./apps/server
COPY --from=server-builder /app/packages/eslint-config-base/package.json ./packages/eslint-config-base/
COPY --from=server-builder /app/packages/shared-types/package.json ./packages/shared-types/
COPY --from=server-builder /app/packages/shared-utils/package.json ./packages/shared-utils/
COPY --from=server-builder /app/packages/shared-types/dist ./packages/shared-types/dist

# Prisma 在没有 schema enum 时只生成 enums.d.ts；CJS 客户端仍会加载该模块。
RUN test -f apps/server/dist/generated/prisma/enums.js || printf '"use strict";\nObject.defineProperty(exports, "__esModule", { value: true });\n' > apps/server/dist/generated/prisma/enums.js

EXPOSE 3000

CMD ["node", "apps/server/dist/main.js"]
