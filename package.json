{
  "name": "petcare-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PetCare宠伴 - 双模式O2O宠物服务平台",
  "scripts": {
    "build": "turbo run build",
    "build:admin": "pnpm --filter @petcare/admin build",
    "build:miniapp": "pnpm --filter @petcare/miniapp build:weapp",
    "build:miniapp:h5": "pnpm --filter @petcare/miniapp build:h5",
    "build:server": "pnpm --filter @petcare/server build",
    "dev": "turbo run dev --filter=@petcare/admin --filter=@petcare/server --filter=@petcare/miniapp",
    "dev:admin": "pnpm --filter @petcare/admin dev",
    "dev:miniapp": "pnpm --filter @petcare/miniapp dev:weapp",
    "dev:miniapp:h5": "pnpm --filter @petcare/miniapp dev:h5",
    "dev:server": "pnpm --filter @petcare/server start:dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test:tooling": "node --test scripts/repository-policy.test.mjs scripts/clean.test.mjs scripts/workspace-contract.test.mjs",
    "test": "pnpm test:tooling && turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "pnpm --filter @petcare/server test:e2e && pnpm --filter @petcare/admin test:e2e",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "turbo run clean && node scripts/clean.mjs node_modules .turbo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s -r 0",
    "release": "pnpm changelog && git add CHANGELOG.md && git commit -m \"docs: 更新发布变更日志\" && git tag",
    "start:server": "pnpm --filter @petcare/server start:prod"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "9.39.0",
    "@petcare/eslint-config-base": "workspace:*",
    "conventional-changelog": "^8.1.0",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "eslint": "9.39.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "3.9.0",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.64.0"
  },
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": ">=11.0.0 <12"
  },
  "packageManager": "pnpm@11.15.1",
  "lint-staged": {
    "apps/admin/src/**/*.{ts,tsx}": [
      "corepack pnpm --filter @petcare/admin exec -- prettier --write",
      "corepack pnpm --filter @petcare/admin exec -- eslint . --fix",
      "corepack pnpm --filter @petcare/admin exec -- vitest run --changed"
    ],
    "apps/miniapp/**/*.{ts,tsx,js,mjs}": [
      "corepack pnpm --filter @petcare/miniapp exec -- prettier --write",
      "corepack pnpm --filter @petcare/miniapp exec -- eslint --fix"
    ],
    "apps/miniapp/**/*.css": [
      "corepack pnpm --filter @petcare/miniapp exec -- prettier --write"
    ],
    "apps/server/src/**/*.ts": [
      "corepack pnpm --filter @petcare/server exec -- prettier --write",
      "corepack pnpm --filter @petcare/server exec -- eslint . --fix",
      "corepack pnpm --filter @petcare/server exec -- jest --passWithNoTests --findRelatedTests"
    ],
    "packages/shared-types/**/*.ts": [
      "corepack pnpm --filter @petcare/shared-types exec -- prettier --write",
      "corepack pnpm --filter @petcare/shared-types exec -- eslint . --fix",
      "corepack pnpm --filter @petcare/shared-types exec -- vitest run --changed"
    ],
    "packages/shared-utils/**/*.ts": [
      "corepack pnpm --filter @petcare/shared-utils exec -- prettier --write",
      "corepack pnpm --filter @petcare/shared-utils exec -- eslint . --fix",
      "corepack pnpm --filter @petcare/shared-utils exec -- vitest run --changed"
    ],
    "packages/api-client/**/*.ts": [
      "corepack pnpm --filter @petcare/api-client exec -- prettier --write",
      "corepack pnpm --filter @petcare/api-client exec -- eslint . --fix",
      "corepack pnpm --filter @petcare/api-client exec -- vitest run --changed"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
