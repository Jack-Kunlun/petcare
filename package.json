{
  "name": "petcare-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PetCare宠伴 - 双模式O2O宠物服务平台",
  "scripts": {
    "build": "turbo run build",
    "build:admin": "pnpm --filter @petcare/admin build",
    "build:miniapp:h5": "pnpm --filter @petcare/miniapp build:h5",
    "build:miniapp:mp-weixin": "pnpm --filter @petcare/miniapp build:mp-weixin",
    "build:miniapp:app-android": "pnpm --filter @petcare/miniapp build:app-android",
    "build:miniapp:app-ios": "pnpm --filter @petcare/miniapp build:app-ios",
    "build:server": "pnpm --filter @petcare/server build",
    "dev": "turbo run dev --filter=@petcare/admin --filter=@petcare/server --filter=@petcare/miniapp --filter=@petcare/website",
    "dev:admin": "pnpm --filter @petcare/admin dev",
    "dev:miniapp:h5": "pnpm --filter @petcare/miniapp dev:h5",
    "dev:miniapp:mp-weixin": "pnpm --filter @petcare/miniapp dev:mp-weixin",
    "dev:miniapp:app-android": "pnpm --filter @petcare/miniapp dev:app-android",
    "dev:miniapp:app-ios": "pnpm --filter @petcare/miniapp dev:app-ios",
    "dev:server": "pnpm --filter @petcare/server start:dev",
    "typecheck": "turbo run typecheck",
    "lint": "pnpm lint:styles && pnpm lint:scripts && turbo run lint",
    "lint:styles": "node scripts/style-policy.mjs admin && node scripts/style-policy.mjs website",
    "lint:scripts": "node node_modules/eslint/bin/eslint.js scripts",
    "test:tooling": "node --test scripts/repository-policy.test.mjs scripts/dependency-alignment.test.mjs scripts/clean.test.mjs scripts/workspace-contract.test.mjs scripts/compose-policy.test.mjs scripts/ci-policy.test.mjs scripts/style-policy.test.mjs scripts/style-output-policy.test.mjs scripts/admin-e2e-runner.test.mjs scripts/miniapp-minimal-shell.test.mjs",
    "test": "pnpm test:tooling && turbo run test",
    "test:ci": "pnpm test:tooling && turbo run test --concurrency=1",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "pnpm --filter @petcare/server test:e2e && pnpm --filter @petcare/admin test:e2e",
    "commit:check": "node scripts/commit-check.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "turbo run clean && node scripts/clean.mjs node_modules .turbo",
    "clean:modules": "node scripts/clean.mjs --modules",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preinstall": "node scripts/enforce-pnpm.mjs",
    "prepare": "husky",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s -r 0",
    "release": "pnpm changelog && git add CHANGELOG.md && git commit -m \"docs: 更新发布变更日志\" && git tag",
    "start:server": "pnpm --filter @petcare/server start:prod"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "9.39.5",
    "@petcare/eslint-config-base": "workspace:*",
    "conventional-changelog": "^8.1.0",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "eslint": "9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "husky": "^9.1.7",
    "jest-environment-node": "30.4.1",
    "lint-staged": "^17.1.0",
    "prettier": "3.9.0",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.66.0"
  },
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "packageManager": "pnpm@11.15.1",
  "lint-staged": {
    "apps/admin/src/**/*.{ts,tsx}": [
      "prettier --write",
      "pnpm --filter @petcare/admin exec -- eslint --fix"
    ],
    "apps/miniapp/**/*.{js,mjs,ts,vue}": [
      "prettier --write",
      "pnpm --filter @petcare/miniapp exec -- eslint --fix"
    ],
    "apps/miniapp/**/*.{css,scss,json}": [
      "prettier --write"
    ],
    "apps/miniapp/**/*.{md,html}": [
      "prettier --write"
    ],
    "apps/server/src/**/*.ts": [
      "prettier --write",
      "pnpm --filter @petcare/server exec -- eslint --fix"
    ],
    "apps/website/**/*.{astro,ts,css,json}": [
      "prettier --write",
      "pnpm --filter @petcare/website exec -- eslint --fix"
    ],
    "packages/shared-types/**/*.ts": [
      "prettier --write",
      "pnpm --filter @petcare/shared-types exec -- eslint --fix"
    ],
    "packages/shared-utils/**/*.ts": [
      "prettier --write",
      "pnpm --filter @petcare/shared-utils exec -- eslint --fix"
    ],
    "packages/api-client/**/*.ts": [
      "prettier --write",
      "pnpm --filter @petcare/api-client exec -- eslint --fix"
    ],
    "scripts/**/*.{js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
