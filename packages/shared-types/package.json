{
  "name": "@petcare/shared-types",
  "version": "1.0.0",
  "description": "PetCare共享类型定义",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "node ../../scripts/clean.mjs dist coverage .turbo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:staged": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:staged": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run src --passWithNoTests",
    "test:run": "vitest run src",
    "test:coverage": "vitest run src --coverage"
  },
  "devDependencies": {
    "@petcare/eslint-config-base": "workspace:*",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "9.39.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
